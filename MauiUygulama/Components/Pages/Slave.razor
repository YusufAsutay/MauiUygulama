@page "/slave"
@using System.Text
@using MauiUygulama.Core.Interfaces
@using MauiUygulama.Models

@implements IDisposable

@inject ITcpServerService TcpServer

<PageTitle>Slave Modu</PageTitle>

<div class="container mt-4">
    <h1>Slave Modu</h1>

    <p class="text-muted">
        TCP sunucusunun dinleyeceği IP adresini ve portu giriniz.
    </p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">

            <div class="mb-3">
                <label for="serverIpAddress" class="form-label">
                    Dinleme IP Adresi
                </label>

                <input id="serverIpAddress"
                       class="form-control"
                       type="text"
                       placeholder="127.0.0.1"
                       @bind="_settings.IpAddress"
                       disabled="@(_isBusy || TcpServer.IsRunning)" />
            </div>

            <div class="mb-3">
                <label for="serverPort" class="form-label">
                    Dinleme Portu
                </label>

                <input id="serverPort"
                       class="form-control"
                       type="number"
                       min="1"
                       max="65535"
                       @bind="_settings.Port"
                       disabled="@(_isBusy || TcpServer.IsRunning)" />
            </div>

            <div class="mb-3">
                <strong>Sunucu durumu: </strong>

                @if (TcpServer.IsRunning)
                {
                    <span class="badge bg-success">
                        Çalışıyor
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Durduruldu
                    </span>
                }
            </div>

            <div class="mb-3">
                <strong>Bağlı Master sayısı: </strong>

                <span class="badge bg-primary">
                    @TcpServer.ConnectedClientCount
                </span>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-success"
                        @onclick="StartServerAsync"
                        disabled="@(_isBusy || TcpServer.IsRunning)">
                    @if (_isBusy && !TcpServer.IsRunning)
                    {
                        <span>Başlatılıyor...</span>
                    }
                    else
                    {
                        <span>Sunucuyu Başlat</span>
                    }
                </button>

                <button class="btn btn-danger"
                        @onclick="StopServerAsync"
                        disabled="@(_isBusy || !TcpServer.IsRunning)">
                    Sunucuyu Durdur
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3"
                     role="alert">
                    @_message
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    Gelen TCP Verileri
                </h5>

                <button class="btn btn-sm btn-outline-danger"
                        @onclick="ClearReceivedData"
                        disabled="@(_receivedItems.Count == 0)">
                    Listeyi Temizle
                </button>
            </div>

            @if (_receivedItems.Count == 0)
            {
                <div class="alert alert-secondary mt-3 mb-0">
                    Henüz veri alınmadı.
                </div>
            }
            else
            {
                @foreach (ReceivedDataItem item in _receivedItems)
                {
                    <div class="border rounded p-3 mt-3">
                        <div class="d-flex justify-content-between">
                            <strong>Master: @item.ClientName</strong>
                            <small class="text-muted">
                                @item.ReceivedAt.ToString("HH:mm:ss")
                            </small>
                        </div>

                        <div class="mt-3">
                            <strong>Metin:</strong>

                            <div class="bg-light border rounded p-2 mt-1">
                                @item.Text
                            </div>
                        </div>

                        <div class="mt-3">
                            <strong>HEX:</strong>

                            <div class="bg-dark text-light border rounded p-2 mt-1 font-monospace">
                                @item.Hex
                            </div>
                        </div>

                        <div class="mt-2 text-muted">
                            Veri uzunluğu: @item.ByteCount byte
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <a class="btn btn-secondary mt-3" href="/">
        Mod Seçimine Dön
    </a>
</div>

@code {
    private readonly List<ReceivedDataItem> _receivedItems = new();

    private readonly TcpServerSettings _settings = new()
    {
        IpAddress = "127.0.0.1",
        Port = 1502,
        Backlog = 100,
        ReceiveBufferSize = 4096
    };

    private bool _isBusy;
    private bool _isError;
    private string? _message;

    protected override void OnInitialized()
    {
        TcpServer.ServerStateChanged += OnServerStateChanged;
        TcpServer.ClientConnected += OnClientConnected;
        TcpServer.ClientDisconnected += OnClientDisconnected;
        TcpServer.DataReceived += OnDataReceived;
        TcpServer.ServerError += OnServerError;
    }

    private void OnDataReceived(
    Guid clientId,
    ReadOnlyMemory<byte> data)
    {
        byte[] receivedBytes = data.ToArray();

        _ = InvokeAsync(() =>
        {
            string text = Encoding.UTF8.GetString(receivedBytes);

            string hex = BitConverter
                .ToString(receivedBytes)
                .Replace("-", " ");

            _receivedItems.Insert(
                0,
                new ReceivedDataItem
                {
                    ClientName = clientId.ToString("N")[..8],
                    ReceivedAt = DateTime.Now,
                    Text = text,
                    Hex = hex,
                    ByteCount = receivedBytes.Length
                });

            // Ekranda en fazla son 100 kayıt tutulur.
            if (_receivedItems.Count > 100)
            {
                _receivedItems.RemoveAt(
                    _receivedItems.Count - 1);
            }

            _isError = false;
            _message =
                $"Master’dan {receivedBytes.Length} byte veri alındı.";

            StateHasChanged();
        });
    }

    private void ClearReceivedData()
    {
        _receivedItems.Clear();
    }

    private async Task StartServerAsync()
    {
        if (TcpServer.IsRunning)
        {
            return;
        }

        _isBusy = true;
        _isError = false;
        _message = null;

        try
        {
            await TcpServer.StartAsync(_settings);

            _message =
                $"TCP sunucusu {_settings.IpAddress}:{_settings.Port} " +
                "adresinde başlatıldı.";
        }
        catch (Exception exception)
        {
            _isError = true;
            _message =
                $"Sunucu başlatılamadı: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task StopServerAsync()
    {
        if (!TcpServer.IsRunning)
        {
            return;
        }

        _isBusy = true;
        _isError = false;
        _message = null;

        try
        {
            await TcpServer.StopAsync();

            _message = "TCP sunucusu durduruldu.";
        }
        catch (Exception exception)
        {
            _isError = true;
            _message =
                $"Sunucu durdurulurken hata oluştu: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnServerStateChanged(bool isRunning)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnClientConnected(
        Guid clientId,
        string remoteEndPoint)
    {
        _ = InvokeAsync(() =>
        {
            _isError = false;
            _message = $"Master bağlandı: {remoteEndPoint}";

            StateHasChanged();
        });
    }

    private void OnClientDisconnected(
        Guid clientId,
        string remoteEndPoint)
    {
        _ = InvokeAsync(() =>
        {
            _isError = false;
            _message = $"Master bağlantısı kapandı: {remoteEndPoint}";

            StateHasChanged();
        });
    }

    private void OnServerError(Exception exception)
    {
        _ = InvokeAsync(() =>
        {
            _isError = true;
            _message = $"Sunucu hatası: {exception.Message}";

            StateHasChanged();
        });
    }

   public void Dispose()
{
    TcpServer.ServerStateChanged -= OnServerStateChanged;
    TcpServer.ClientConnected -= OnClientConnected;
    TcpServer.ClientDisconnected -= OnClientDisconnected;
    TcpServer.DataReceived -= OnDataReceived;
    TcpServer.ServerError -= OnServerError;
}

    private sealed class ReceivedDataItem
    {
        public string ClientName { get; init; } = string.Empty;

        public DateTime ReceivedAt { get; init; }

        public string Text { get; init; } = string.Empty;

        public string Hex { get; init; } = string.Empty;

        public int ByteCount { get; init; }
    }
}