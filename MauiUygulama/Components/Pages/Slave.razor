@* Merkezî ve interaktif Slave ekranı — düzeltilmiş sürüm 2 *@
@page "/slave"

@using MauiUygulama.Core.Interfaces
@using MauiUygulama.Models

@implements IDisposable

@inject ITcpServerService TcpServer
@inject IModbusFrameStore ModbusFrameStore
@inject IRegisterManager RegisterManager

<PageTitle>Merkezî Slave Modu</PageTitle>

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1 class="mb-1">Merkezî Slave Modu</h1>
            <p class="text-muted mb-0">
                TCP sunucusunu yönetin; Coil ve Holding Register değerlerini izleyip manuel değiştirin.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary">İnteraktif Register Yönetimi</span>
            <a class="btn btn-outline-secondary" href="/">
                Mod Seçimine Dön
            </a>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Slave TCP Sunucusu</h5>
        </div>

        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4 col-md-6">
                    <label for="serverIpAddress" class="form-label">
                        Dinleme IP Adresi
                    </label>
                    <input id="serverIpAddress"
                           class="form-control"
                           type="text"
                           placeholder="127.0.0.1"
                           @bind="_settings.IpAddress"
                           disabled="@(_isBusy || TcpServer.IsRunning)" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <label for="serverPort" class="form-label">
                        Dinleme Portu
                    </label>
                    <input id="serverPort"
                           class="form-control"
                           type="number"
                           min="1"
                           max="65535"
                           @bind="_settings.Port"
                           disabled="@(_isBusy || TcpServer.IsRunning)" />
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="mb-1">
                        <strong>Sunucu durumu:</strong>
                        <span class="badge @(TcpServer.IsRunning ? "bg-success" : "bg-danger") ms-1">
                            @(TcpServer.IsRunning ? "Çalışıyor" : "Durduruldu")
                        </span>
                    </div>
                    <div>
                        <strong>Bağlı Master:</strong>
                        <span class="badge bg-primary ms-1">
                            @TcpServer.ConnectedClientCount
                        </span>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="d-flex gap-2">
                        <button class="btn btn-success flex-fill"
                                @onclick="StartServerAsync"
                                disabled="@(_isBusy || TcpServer.IsRunning)">
                            @(_isBusy && !TcpServer.IsRunning
                                ? "Başlatılıyor..."
                                : "Sunucuyu Başlat")
                        </button>

                        <button class="btn btn-danger flex-fill"
                                @onclick="StopServerAsync"
                                disabled="@(_isBusy || !TcpServer.IsRunning)">
                            Durdur
                        </button>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_serverMessage))
            {
                <div class="alert @(_isServerError ? "alert-danger" : "alert-success") mt-3 mb-0"
                     role="alert">
                    @_serverMessage
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="mb-1">Slave Veri Alanı</h5>
                    <small class="text-muted">
                        Adresler Modbus PDU içindeki sıfır tabanlı adreslerdir.
                    </small>
                </div>

                <button class="btn btn-sm btn-outline-primary"
                        @onclick="() => RefreshRegisterRows()">
                    Değerleri Yenile
                </button>
            </div>
        </div>

        <div class="card-body">
            <div class="row g-3 align-items-end mb-4">
                <div class="col-md-4 col-lg-3">
                    <label for="startAddress" class="form-label">
                        Başlangıç Adresi
                    </label>
                    <input id="startAddress"
                           class="form-control"
                           type="number"
                           min="0"
                           max="65535"
                           @bind="_startAddress" />
                </div>

                <div class="col-md-4 col-lg-3">
                    <label for="visibleCount" class="form-label">
                        Gösterilecek Adres Sayısı
                    </label>
                    <input id="visibleCount"
                           class="form-control"
                           type="number"
                           min="1"
                           max="100"
                           @bind="_visibleAddressCount" />
                </div>

                <div class="col-md-4 col-lg-2">
                    <button class="btn btn-primary w-100"
                            @onclick="ApplyAddressRange">
                        Adresleri Getir
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_registerMessage))
            {
                <div class="alert @(_isRegisterError ? "alert-danger" : "alert-success") py-2"
                     role="alert">
                    @_registerMessage
                </div>
            }

            <ul class="nav nav-pills mb-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(_activeTable == RegisterTable.Coils ? "active" : null)"
                            type="button"
                            @onclick="() => SelectTable(RegisterTable.Coils)">
                        Coils (FC01)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(_activeTable == RegisterTable.HoldingRegisters ? "active" : null)"
                            type="button"
                            @onclick="() => SelectTable(RegisterTable.HoldingRegisters)">
                        Holding Registers (FC03 / FC06)
                    </button>
                </li>
            </ul>

            @if (_activeTable == RegisterTable.Coils)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Adres</th>
                                <th scope="col">Etiket</th>
                                <th scope="col">Manuel Değer</th>
                                <th scope="col">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (CoilRow row in _coilRows)
                            {
                                <tr @key="row.Address">
                                    <td class="fw-semibold">@row.Address</td>
                                    <td class="font-monospace">Coil[@row.Address]</td>
                                    <td>
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   role="switch"
                                                   checked="@row.Value"
                                                   @onchange="args => UpdateCoil(row.Address, args)" />
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @(row.Value ? "bg-success" : "bg-secondary")">
                                            @(row.Value ? "ON / True" : "OFF / False")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Adres</th>
                                <th scope="col">Etiket</th>
                                <th scope="col">Decimal Değer</th>
                                <th scope="col">Hex</th>
                                <th scope="col">Binary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (HoldingRegisterRow row in _holdingRegisterRows)
                            {
                                <tr @key="row.Address">
                                    <td class="fw-semibold">@row.Address</td>
                                    <td class="font-monospace">HR[@row.Address]</td>
                                    <td style="min-width: 170px;">
                                        <input class="form-control form-control-sm"
                                               type="number"
                                               min="0"
                                               max="65535"
                                               value="@row.Value"
                                               @onchange="args => UpdateHoldingRegister(row.Address, args)" />
                                    </td>
                                    <td class="font-monospace">0x@(row.Value.ToString("X4"))</td>
                                    <td class="font-monospace">
                                        @Convert.ToString(row.Value, 2).PadLeft(16, '0')
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Son Modbus İstekleri</h5>
                <button class="btn btn-sm btn-outline-danger"
                        @onclick="ClearModbusFrames"
                        disabled="@(_modbusFrames.Count == 0)">
                    Geçmişi Temizle
                </button>
            </div>
        </div>

        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(_modbusFrameError))
            {
                <div class="alert alert-danger" role="alert">
                    @_modbusFrameError
                </div>
            }

            @if (_modbusFrames.Count == 0)
            {
                <div class="alert alert-secondary mb-0">
                    Henüz eksiksiz bir Modbus TCP isteği alınmadı.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Zaman</th>
                                <th>Function</th>
                                <th>Unit ID</th>
                                <th>Başlangıç Adresi</th>
                                <th>Miktar / Değer</th>
                                <th>Master</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ModbusFrameRecord item in _modbusFrames)
                            {
                                <tr>
                                    <td>@item.ReceivedAt.ToString("HH:mm:ss")</td>
                                    <td>
                                        FC@(item.Frame.FunctionCode.ToString("D2")) —
                                        @GetFunctionName(item.Frame.FunctionCode)
                                    </td>
                                    <td>@item.Frame.UnitId</td>
                                    <td>@GetAddressText(item)</td>
                                    <td>@GetQuantityOrValueText(item)</td>
                                    <td class="font-monospace">
                                        @item.ClientId.ToString()[..8]
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<ModbusFrameRecord> _modbusFrames =
        Array.Empty<ModbusFrameRecord>();

    private readonly List<CoilRow> _coilRows = new();
    private readonly List<HoldingRegisterRow> _holdingRegisterRows = new();

    private readonly TcpServerSettings _settings = new()
    {
        IpAddress = "127.0.0.1",
        Port = 1502,
        Backlog = 100,
        ReceiveBufferSize = 4096
    };

    private RegisterTable _activeTable = RegisterTable.Coils;
    private int _startAddress;
    private int _visibleAddressCount = 16;
    private bool _isBusy;
    private bool _isServerError;
    private bool _isRegisterError;
    private string? _serverMessage;
    private string? _registerMessage;
    private string? _modbusFrameError;

    protected override void OnInitialized()
    {
        TcpServer.ServerStateChanged += OnServerStateChanged;
        TcpServer.ClientConnected += OnClientConnected;
        TcpServer.ClientDisconnected += OnClientDisconnected;
        TcpServer.ServerError += OnServerError;

        ModbusFrameStore.DataChanged += OnModbusFrameStoreChanged;
        RegisterManager.ValueChanged += OnRegisterValueChanged;

        RefreshModbusFrames();
        RefreshRegisterRows();
    }

    private async Task StartServerAsync()
    {
        if (TcpServer.IsRunning)
        {
            return;
        }

        _isBusy = true;
        _isServerError = false;
        _serverMessage = null;

        try
        {
            await TcpServer.StartAsync(_settings);
            _serverMessage =
                $"TCP sunucusu {_settings.IpAddress}:{_settings.Port} adresinde başlatıldı.";
        }
        catch (Exception exception)
        {
            _isServerError = true;
            _serverMessage = $"Sunucu başlatılamadı: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task StopServerAsync()
    {
        if (!TcpServer.IsRunning)
        {
            return;
        }

        _isBusy = true;
        _isServerError = false;
        _serverMessage = null;

        try
        {
            await TcpServer.StopAsync();
            _serverMessage = "TCP sunucusu durduruldu.";
        }
        catch (Exception exception)
        {
            _isServerError = true;
            _serverMessage = $"Sunucu durdurulurken hata oluştu: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void SelectTable(RegisterTable table)
    {
        _activeTable = table;
        _registerMessage = null;
        RefreshRegisterRows();
    }

    private void ApplyAddressRange()
    {
        RefreshRegisterRows(showSuccessMessage: true);
    }

    private void RefreshRegisterRows(bool showSuccessMessage = false)
    {
        if (!TryValidateAddressRange(out ushort startAddress, out ushort quantity))
        {
            return;
        }

        bool[] coils = RegisterManager.ReadCoils(startAddress, quantity);
        ushort[] registers = RegisterManager.ReadHoldingRegisters(startAddress, quantity);

        _coilRows.Clear();
        _holdingRegisterRows.Clear();

        for (int index = 0; index < quantity; index++)
        {
            ushort address = (ushort)(startAddress + index);
            _coilRows.Add(new CoilRow(address, coils[index]));
            _holdingRegisterRows.Add(new HoldingRegisterRow(address, registers[index]));
        }

        _isRegisterError = false;

        if (showSuccessMessage)
        {
            _registerMessage =
                $"{startAddress}–{startAddress + quantity - 1} adresleri yüklendi.";
        }
    }

    private bool TryValidateAddressRange(
        out ushort startAddress,
        out ushort quantity)
    {
        startAddress = 0;
        quantity = 0;

        if (_startAddress < 0 || _startAddress >= RegisterManager.RegisterCount)
        {
            SetRegisterError("Başlangıç adresi 0 ile 65535 arasında olmalıdır.");
            return false;
        }

        if (_visibleAddressCount < 1 || _visibleAddressCount > 100)
        {
            SetRegisterError("Gösterilecek adres sayısı 1 ile 100 arasında olmalıdır.");
            return false;
        }

        if (_startAddress + _visibleAddressCount > RegisterManager.RegisterCount)
        {
            SetRegisterError("Başlangıç adresi ve adres sayısı Modbus sınırını aşıyor.");
            return false;
        }

        startAddress = (ushort)_startAddress;
        quantity = (ushort)_visibleAddressCount;
        return true;
    }

    private void UpdateCoil(ushort address, ChangeEventArgs args)
    {
        try
        {
            bool value = args.Value is bool boolValue
                ? boolValue
                : bool.TryParse(args.Value?.ToString(), out bool parsed) && parsed;

            RegisterManager.WriteSingleCoil(address, value);
            SetRegisterSuccess($"Coil[{address}] değeri {(value ? "ON" : "OFF")} olarak güncellendi.");
        }
        catch (Exception exception)
        {
            SetRegisterError($"Coil değeri güncellenemedi: {exception.Message}");
            RefreshRegisterRows();
        }
    }

    private void UpdateHoldingRegister(ushort address, ChangeEventArgs args)
    {
        if (!ushort.TryParse(args.Value?.ToString(), out ushort value))
        {
            SetRegisterError("Holding Register değeri 0 ile 65535 arasında olmalıdır.");
            RefreshRegisterRows();
            return;
        }

        try
        {
            RegisterManager.WriteSingleHoldingRegister(address, value);
            SetRegisterSuccess($"HR[{address}] değeri {value} olarak güncellendi.");
        }
        catch (Exception exception)
        {
            SetRegisterError($"Holding Register güncellenemedi: {exception.Message}");
            RefreshRegisterRows();
        }
    }

    private void SetRegisterSuccess(string message)
    {
        _isRegisterError = false;
        _registerMessage = message;
    }

    private void SetRegisterError(string message)
    {
        _isRegisterError = true;
        _registerMessage = message;
    }

    private void OnRegisterValueChanged(
        RegisterValueChangedEventArgs change)
    {
        _ = InvokeAsync(() =>
        {
            RefreshRegisterRows();
            StateHasChanged();
        });
    }

    private void OnServerStateChanged(bool isRunning)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnClientConnected(Guid clientId, string remoteEndPoint)
    {
        _ = InvokeAsync(() =>
        {
            _isServerError = false;
            _serverMessage = $"Master bağlandı: {remoteEndPoint}";
            StateHasChanged();
        });
    }

    private void OnClientDisconnected(Guid clientId, string remoteEndPoint)
    {
        _ = InvokeAsync(() =>
        {
            _isServerError = false;
            _serverMessage = $"Master bağlantısı kapandı: {remoteEndPoint}";
            StateHasChanged();
        });
    }

    private void OnServerError(Exception exception)
    {
        _ = InvokeAsync(() =>
        {
            _isServerError = true;
            _serverMessage = $"Sunucu hatası: {exception.Message}";
            StateHasChanged();
        });
    }

    private void OnModbusFrameStoreChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshModbusFrames();
            StateHasChanged();
        });
    }

    private void RefreshModbusFrames()
    {
        _modbusFrames = ModbusFrameStore.Items;
        _modbusFrameError = ModbusFrameStore.LastError;
    }

    private void ClearModbusFrames()
    {
        ModbusFrameStore.Clear();
    }

    private static string GetAddressText(ModbusFrameRecord item)
    {
        return item.StartAddress?.ToString() ?? "—";
    }

    private static string GetQuantityOrValueText(ModbusFrameRecord item)
    {
        return item.Quantity?.ToString() ?? "—";
    }

    private static string GetFunctionName(byte functionCode)
    {
        return functionCode switch
        {
            0x01 => "Read Coils",
            0x03 => "Read Holding Registers",
            0x06 => "Write Single Register",
            _ => "Bilinmeyen fonksiyon"
        };
    }

    public void Dispose()
    {
        TcpServer.ServerStateChanged -= OnServerStateChanged;
        TcpServer.ClientConnected -= OnClientConnected;
        TcpServer.ClientDisconnected -= OnClientDisconnected;
        TcpServer.ServerError -= OnServerError;

        ModbusFrameStore.DataChanged -= OnModbusFrameStoreChanged;
        RegisterManager.ValueChanged -= OnRegisterValueChanged;
    }

    private enum RegisterTable
    {
        Coils,
        HoldingRegisters
    }

    private sealed record CoilRow(ushort Address, bool Value);

    private sealed record HoldingRegisterRow(ushort Address, ushort Value);
}
