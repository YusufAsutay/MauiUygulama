@* Merkezî Slave ekranı — filtreleme, sıralama ve güvenli temizleme sürümü *@
@page "/slave"

@using MauiUygulama.Core.Interfaces
@using MauiUygulama.Models

@implements IDisposable

@inject ITcpServerService TcpServer
@inject IModbusFrameStore ModbusFrameStore
@inject IRegisterManager RegisterManager
@inject ISlaveRegisterViewStore SlaveRegisterViewStore

<PageTitle>Modbus TCP Slave</PageTitle>

<div class="container-fluid modbus-page px-3 px-lg-4 py-4">
    <div class="page-hero d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="page-eyebrow">MODBUS TCP İSTASYONU</span>
            <h1 class="mb-1">Slave Kontrol Merkezi</h1>
            <p class="mb-0">
                İstekleri izleyin, register değerlerini yönetin ve sunucu durumunu takip edin.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="connection-pill @(TcpServer.IsRunning ? "is-online" : "is-offline")">
                <span class="status-dot"></span>
                @(TcpServer.IsRunning ? "Sunucu çalışıyor" : "Sunucu kapalı")
            </span>
            <a class="btn btn-light hero-back-button" href="/">
                Mod Seçimine Dön
            </a>
        </div>
    </div>

    <div class="card surface-card connection-card mt-4">
        <div class="card-header bg-white py-3">
            <div class="section-title-row">
                <div>
                    <span class="section-eyebrow">BAĞLANTI</span>
                    <h2 class="mb-0">Slave TCP Sunucusu</h2>
                </div>
                <span class="protocol-badge">TCP · 0–65535 adres</span>
            </div>
        </div>

        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4 col-md-6">
                    <label for="serverIpAddress" class="form-label">
                        Dinleme IP Adresi
                    </label>
                    <input id="serverIpAddress"
                           class="form-control"
                           type="text"
                           placeholder="127.0.0.1"
                           @bind="_settings.IpAddress"
                           disabled="@(_isBusy || TcpServer.IsRunning)" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <label for="serverPort" class="form-label">
                        Dinleme Portu
                    </label>
                    <input id="serverPort"
                           class="form-control"
                           type="number"
                           min="1"
                           max="65535"
                           @bind="_settings.Port"
                           disabled="@(_isBusy || TcpServer.IsRunning)" />
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="server-stats">
                        <div><small>Sunucu</small><strong>@(TcpServer.IsRunning ? "Çalışıyor" : "Durduruldu")</strong></div>
                        <div><small>Bağlı Master</small><strong>@TcpServer.ConnectedClientCount</strong></div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="d-flex gap-2">
                        <button class="btn btn-success flex-fill"
                                @onclick="StartServerAsync"
                                disabled="@(_isBusy || TcpServer.IsRunning)">
                            @(_isBusy && !TcpServer.IsRunning
                                ? "Başlatılıyor..."
                                : "Sunucuyu Başlat")
                        </button>

                        <button class="btn btn-danger flex-fill"
                                @onclick="StopServerAsync"
                                disabled="@(_isBusy || !TcpServer.IsRunning)">
                            Durdur
                        </button>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_serverMessage))
            {
                <div class="alert @(_isServerError ? "alert-danger" : "alert-success") mt-3 mb-0"
                     role="alert">
                    @_serverMessage
                </div>
            }
        </div>
    </div>

    <div class="card surface-card register-card mt-4">
        <div class="card-header bg-white py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="section-eyebrow">REGISTER YÖNETİMİ</span>
                    <h2 class="mb-1">Slave Veri Alanı</h2>
                    <small class="text-muted">
                        Başarılı Modbus isteklerindeki adresler otomatik olarak bu tabloya eklenir.
                    </small>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="count-badge">
                        @VisibleRegisterRows.Count / @_registerRows.Count adres gösteriliyor
                    </span>
                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="RefreshRegisterRows">
                        Değerleri Yenile
                    </button>
                    <button class="btn btn-sm btn-outline-danger"
                            @onclick="ShowClearTrackedRegistersConfirmation"
                            disabled="@(_registerRows.Count == 0)">
                        Takip Edilen Adresleri Temizle
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="row g-3 align-items-end mb-3 filter-toolbar">
                <div class="col-lg-4 col-md-6">
                    <label for="registerTypeFilter" class="form-label">
                        Register Türü
                    </label>
                    <select id="registerTypeFilter"
                            class="form-select"
                            @bind="_registerFilter">
                        <option value="@RegisterFilter.All">Tüm Türler</option>
                        <option value="@RegisterFilter.Coil">Yalnızca Coil</option>
                        <option value="@RegisterFilter.HoldingRegister">
                            Yalnızca Holding Register
                        </option>
                    </select>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label for="registerSortOrder" class="form-label">
                        Sıralama
                    </label>
                    <select id="registerSortOrder"
                            class="form-select"
                            @bind="_registerSortOrder">
                        <option value="@RegisterSortOrder.AddressAscending">
                            Adres — Küçükten Büyüğe
                        </option>
                        <option value="@RegisterSortOrder.AddressDescending">
                            Adres — Büyükten Küçüğe
                        </option>
                        <option value="@RegisterSortOrder.LastAccessedDescending">
                            Son Erişim — Yeniden Eskiye
                        </option>
                        <option value="@RegisterSortOrder.LastAccessedAscending">
                            Son Erişim — Eskiden Yeniye
                        </option>
                    </select>
                </div>

                <div class="col-lg-4">
                    <button class="btn btn-outline-secondary w-100"
                            @onclick="ResetRegisterViewOptions"
                            disabled="@IsRegisterViewAtDefault">
                        Filtre ve Sıralamayı Sıfırla
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_registerMessage))
            {
                <div class="alert @(_isRegisterError ? "alert-danger" : "alert-success") py-2"
                     role="alert">
                    @_registerMessage
                </div>
            }

            @if (_showClearTrackedRegistersConfirmation)
            {
                <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-3"
                     role="alert">
                    <div>
                        <strong>Takip edilen adresler tablodan kaldırılsın mı?</strong>
                        <div class="small mt-1">
                            Coil ve Holding Register değerleri silinmez; yalnızca görünür adres listesi temizlenir.
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-danger"
                                @onclick="ConfirmClearTrackedRegisters">
                            Evet, Listeyi Temizle
                        </button>
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="CancelClearTrackedRegisters">
                            Vazgeç
                        </button>
                    </div>
                </div>
            }

            <div class="table-responsive border rounded">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Tür</th>
                            <th scope="col">Adres</th>
                            <th scope="col">Son Fonksiyon</th>
                            <th scope="col">Decimal Değer</th>
                            <th scope="col">Hex</th>
                            <th scope="col">Binary</th>
                            <th scope="col">Son Erişim</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_registerRows.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    Henüz takip edilen bir adres yok. Master'dan başarılı bir FC01,
                                    FC03 veya FC06 isteği gönderildiğinde adresler otomatik eklenecek.
                                </td>
                            </tr>
                        }
                        else if (VisibleRegisterRows.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    Seçilen register türüne uyan takip edilmiş bir adres bulunamadı.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (SlaveRegisterRow row in VisibleRegisterRows)
                            {
                                <tr @key="GetRowKey(row)">
                                    <td>
                                        <span class="area-badge @(row.Area == RegisterArea.Coil ? "coil-badge" : "holding-badge")">
                                            @GetAreaName(row.Area)
                                        </span>
                                    </td>
                                    <td class="fw-semibold">@row.Address</td>
                                    <td><span class="function-badge">FC@(row.FunctionCode.ToString("D2"))</span></td>
                                    <td style="min-width: 170px;">
                                        @if (row.Area == RegisterArea.Coil)
                                        {
                                            <div class="form-check form-switch mb-0">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       role="switch"
                                                       checked="@row.BoolValue"
                                                       @onchange="args => UpdateCoil(row.Address, args)" />
                                                <span class="ms-2">
                                                    @(row.BoolValue ? "1 / ON" : "0 / OFF")
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm"
                                                   type="number"
                                                   min="0"
                                                   max="65535"
                                                   value="@row.Value"
                                                   @onchange="args => UpdateHoldingRegister(row.Address, args)" />
                                        }
                                    </td>
                                    <td class="font-monospace">@row.HexText</td>
                                    <td class="font-monospace">@row.BinaryText</td>
                                    <td>@row.LastAccessedUtc.ToLocalTime().ToString("HH:mm:ss")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card surface-card history-card mt-4">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="section-eyebrow">İSTEK GEÇMİŞİ</span>
                    <h2 class="mb-0">Son Modbus İstekleri</h2>
                </div>
                <button class="btn btn-sm btn-outline-danger"
                        @onclick="ShowClearHistoryConfirmation"
                        disabled="@(_modbusFrames.Count == 0)">
                    İstek Geçmişini Temizle
                </button>
            </div>
        </div>

        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(_modbusFrameMessage))
            {
                <div class="alert alert-success" role="alert">
                    @_modbusFrameMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_modbusFrameError))
            {
                <div class="alert alert-danger" role="alert">
                    @_modbusFrameError
                </div>
            }

            @if (_showClearHistoryConfirmation)
            {
                <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-3"
                     role="alert">
                    <div>
                        <strong>Modbus istek geçmişi temizlensin mi?</strong>
                        <div class="small mt-1">
                            Bu işlem register tablosunu ve Slave değerlerini etkilemez.
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-danger"
                                @onclick="ConfirmClearModbusFrames">
                            Evet, Geçmişi Temizle
                        </button>
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="CancelClearHistory">
                            Vazgeç
                        </button>
                    </div>
                </div>
            }

            @if (_modbusFrames.Count == 0)
            {
                <div class="alert alert-secondary mb-0">
                    Henüz eksiksiz bir Modbus TCP isteği alınmadı.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Zaman</th>
                                <th>Function</th>
                                <th>Unit ID</th>
                                <th>Başlangıç Adresi</th>
                                <th>Miktar / Değer</th>
                                <th>Master</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ModbusFrameRecord item in _modbusFrames)
                            {
                                <tr>
                                    <td>@item.ReceivedAt.ToString("HH:mm:ss")</td>
                                    <td>
                                        FC@(item.Frame.FunctionCode.ToString("D2")) —
                                        @GetFunctionName(item.Frame.FunctionCode)
                                    </td>
                                    <td>@item.Frame.UnitId</td>
                                    <td>@GetAddressText(item)</td>
                                    <td>@GetQuantityOrValueText(item)</td>
                                    <td class="font-monospace">
                                        @item.ClientId.ToString()[..8]
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<ModbusFrameRecord> _modbusFrames =
        Array.Empty<ModbusFrameRecord>();

    private IReadOnlyList<SlaveRegisterRow> _registerRows =
        Array.Empty<SlaveRegisterRow>();

    private RegisterFilter _registerFilter = RegisterFilter.All;
    private RegisterSortOrder _registerSortOrder = RegisterSortOrder.AddressAscending;

    private readonly TcpServerSettings _settings = new()
    {
        IpAddress = "127.0.0.1",
        Port = 1502,
        Backlog = 100,
        ReceiveBufferSize = 4096
    };

    private bool _isBusy;
    private bool _isServerError;
    private bool _isRegisterError;
    private bool _showClearTrackedRegistersConfirmation;
    private bool _showClearHistoryConfirmation;
    private string? _serverMessage;
    private string? _registerMessage;
    private string? _modbusFrameError;
    private string? _modbusFrameMessage;

    private IReadOnlyList<SlaveRegisterRow> VisibleRegisterRows
    {
        get
        {
            IEnumerable<SlaveRegisterRow> query = _registerRows;

            query = _registerFilter switch
            {
                RegisterFilter.Coil =>
                    query.Where(row => row.Area == RegisterArea.Coil),

                RegisterFilter.HoldingRegister =>
                    query.Where(row => row.Area == RegisterArea.HoldingRegister),

                _ => query
            };

            query = _registerSortOrder switch
            {
                RegisterSortOrder.AddressDescending =>
                    query.OrderByDescending(row => row.Address)
                         .ThenBy(row => row.Area),

                RegisterSortOrder.LastAccessedDescending =>
                    query.OrderByDescending(row => row.LastAccessedUtc)
                         .ThenBy(row => row.Area)
                         .ThenBy(row => row.Address),

                RegisterSortOrder.LastAccessedAscending =>
                    query.OrderBy(row => row.LastAccessedUtc)
                         .ThenBy(row => row.Area)
                         .ThenBy(row => row.Address),

                _ =>
                    query.OrderBy(row => row.Address)
                         .ThenBy(row => row.Area)
            };

            return query.ToArray();
        }
    }

    private bool IsRegisterViewAtDefault =>
        _registerFilter == RegisterFilter.All &&
        _registerSortOrder == RegisterSortOrder.AddressAscending;

    protected override void OnInitialized()
    {
        TcpServer.ServerStateChanged += OnServerStateChanged;
        TcpServer.ClientConnected += OnClientConnected;
        TcpServer.ClientDisconnected += OnClientDisconnected;
        TcpServer.ServerError += OnServerError;

        ModbusFrameStore.DataChanged += OnModbusFrameStoreChanged;
        SlaveRegisterViewStore.Changed += OnSlaveRegisterViewStoreChanged;

        RefreshModbusFrames();
        RefreshRegisterRows();
    }

    private async Task StartServerAsync()
    {
        if (TcpServer.IsRunning)
        {
            return;
        }

        _isBusy = true;
        _isServerError = false;
        _serverMessage = null;

        try
        {
            await TcpServer.StartAsync(_settings);
            _serverMessage =
                $"TCP sunucusu {_settings.IpAddress}:{_settings.Port} adresinde başlatıldı.";
        }
        catch (Exception exception)
        {
            _isServerError = true;
            _serverMessage = $"Sunucu başlatılamadı: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task StopServerAsync()
    {
        if (!TcpServer.IsRunning)
        {
            return;
        }

        _isBusy = true;
        _isServerError = false;
        _serverMessage = null;

        try
        {
            await TcpServer.StopAsync();
            _serverMessage = "TCP sunucusu durduruldu.";
        }
        catch (Exception exception)
        {
            _isServerError = true;
            _serverMessage = $"Sunucu durdurulurken hata oluştu: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void RefreshRegisterRows()
    {
        _registerRows = SlaveRegisterViewStore.GetRows();
    }

    private void ResetRegisterViewOptions()
    {
        _registerFilter = RegisterFilter.All;
        _registerSortOrder = RegisterSortOrder.AddressAscending;
    }

    private void ShowClearTrackedRegistersConfirmation()
    {
        _showClearTrackedRegistersConfirmation = true;
        _registerMessage = null;
    }

    private void CancelClearTrackedRegisters()
    {
        _showClearTrackedRegistersConfirmation = false;
    }

    private void ConfirmClearTrackedRegisters()
    {
        int clearedRowCount = _registerRows.Count;

        SlaveRegisterViewStore.Clear();
        _showClearTrackedRegistersConfirmation = false;
        SetRegisterSuccess(
            $"{clearedRowCount} takip edilen adres tablodan kaldırıldı. Register değerleri korunuyor.");
    }

    private void UpdateCoil(ushort address, ChangeEventArgs args)
    {
        try
        {
            bool value = args.Value is bool boolValue
                ? boolValue
                : bool.TryParse(args.Value?.ToString(), out bool parsed) && parsed;

            RegisterManager.WriteSingleCoil(address, value);
            SetRegisterSuccess($"Coil[{address}] değeri {(value ? "ON" : "OFF")} olarak güncellendi.");
        }
        catch (Exception exception)
        {
            SetRegisterError($"Coil değeri güncellenemedi: {exception.Message}");
            RefreshRegisterRows();
        }
    }

    private void UpdateHoldingRegister(ushort address, ChangeEventArgs args)
    {
        if (!ushort.TryParse(args.Value?.ToString(), out ushort value))
        {
            SetRegisterError("Holding Register değeri 0 ile 65535 arasında olmalıdır.");
            RefreshRegisterRows();
            return;
        }

        try
        {
            RegisterManager.WriteSingleHoldingRegister(address, value);
            SetRegisterSuccess($"HR[{address}] değeri {value} olarak güncellendi.");
        }
        catch (Exception exception)
        {
            SetRegisterError($"Holding Register güncellenemedi: {exception.Message}");
            RefreshRegisterRows();
        }
    }

    private void SetRegisterSuccess(string message)
    {
        _isRegisterError = false;
        _registerMessage = message;
    }

    private void SetRegisterError(string message)
    {
        _isRegisterError = true;
        _registerMessage = message;
    }

    private void OnSlaveRegisterViewStoreChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshRegisterRows();
            StateHasChanged();
        });
    }

    private void OnServerStateChanged(bool isRunning)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnClientConnected(Guid clientId, string remoteEndPoint)
    {
        _ = InvokeAsync(() =>
        {
            _isServerError = false;
            _serverMessage = $"Master bağlandı: {remoteEndPoint}";
            StateHasChanged();
        });
    }

    private void OnClientDisconnected(Guid clientId, string remoteEndPoint)
    {
        _ = InvokeAsync(() =>
        {
            _isServerError = false;
            _serverMessage = $"Master bağlantısı kapandı: {remoteEndPoint}";
            StateHasChanged();
        });
    }

    private void OnServerError(Exception exception)
    {
        _ = InvokeAsync(() =>
        {
            _isServerError = true;
            _serverMessage = $"Sunucu hatası: {exception.Message}";
            StateHasChanged();
        });
    }

    private void OnModbusFrameStoreChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshModbusFrames();
            StateHasChanged();
        });
    }

    private void RefreshModbusFrames()
    {
        _modbusFrames = ModbusFrameStore.Items;
        _modbusFrameError = ModbusFrameStore.LastError;

        if (_modbusFrames.Count > 0)
        {
            _modbusFrameMessage = null;
            _showClearHistoryConfirmation = false;
        }
    }

    private void ShowClearHistoryConfirmation()
    {
        _showClearHistoryConfirmation = true;
        _modbusFrameMessage = null;
    }

    private void CancelClearHistory()
    {
        _showClearHistoryConfirmation = false;
    }

    private void ConfirmClearModbusFrames()
    {
        int clearedFrameCount = _modbusFrames.Count;

        ModbusFrameStore.Clear();
        _showClearHistoryConfirmation = false;
        _modbusFrameMessage =
            $"{clearedFrameCount} Modbus istek kaydı temizlendi. Register tablosu ve değerler korunuyor.";
    }

    private static string GetAddressText(ModbusFrameRecord item)
    {
        return item.StartAddress?.ToString() ?? "—";
    }

    private static string GetQuantityOrValueText(ModbusFrameRecord item)
    {
        return item.Quantity?.ToString() ?? "—";
    }

    private static string GetFunctionName(byte functionCode)
    {
        return functionCode switch
        {
            0x01 => "Read Coils",
            0x03 => "Read Holding Registers",
            0x06 => "Write Single Holding Register",
            _ => "Bilinmeyen fonksiyon"
        };
    }

    public void Dispose()
    {
        TcpServer.ServerStateChanged -= OnServerStateChanged;
        TcpServer.ClientConnected -= OnClientConnected;
        TcpServer.ClientDisconnected -= OnClientDisconnected;
        TcpServer.ServerError -= OnServerError;

        ModbusFrameStore.DataChanged -= OnModbusFrameStoreChanged;
        SlaveRegisterViewStore.Changed -= OnSlaveRegisterViewStoreChanged;
    }

    private static string GetAreaName(RegisterArea area)
    {
        return area switch
        {
            RegisterArea.Coil => "Coil",
            RegisterArea.HoldingRegister => "Holding Register",
            _ => area.ToString()
        };
    }

    private static string GetRowKey(SlaveRegisterRow row)
    {
        return $"{row.Area}:{row.Address}";
    }

    private enum RegisterFilter
    {
        All,
        Coil,
        HoldingRegister
    }

    private enum RegisterSortOrder
    {
        AddressAscending,
        AddressDescending,
        LastAccessedDescending,
        LastAccessedAscending
    }
}
