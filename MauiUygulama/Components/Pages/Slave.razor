@page "/slave"

@using MauiUygulama.Core.Interfaces
@using MauiUygulama.Models

@implements IDisposable

@inject ITcpServerService TcpServer
@inject ITcpReceivedDataStore ReceivedDataStore
@inject IModbusFrameStore ModbusFrameStore

<PageTitle>Slave Modu</PageTitle>

<div class="container mt-4">
    <h1>Slave Modu</h1>

    <p class="text-muted">
        TCP sunucusunun dinleyeceği IP adresini ve portu giriniz.
    </p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <div class="mb-3">
                <label for="serverIpAddress" class="form-label">
                    Dinleme IP Adresi
                </label>

                <input id="serverIpAddress"
                       class="form-control"
                       type="text"
                       placeholder="127.0.0.1"
                       @bind="_settings.IpAddress"
                       disabled="@(_isBusy || TcpServer.IsRunning)" />
            </div>

            <div class="mb-3">
                <label for="serverPort" class="form-label">
                    Dinleme Portu
                </label>

                <input id="serverPort"
                       class="form-control"
                       type="number"
                       min="1"
                       max="65535"
                       @bind="_settings.Port"
                       disabled="@(_isBusy || TcpServer.IsRunning)" />
            </div>

            <div class="mb-3">
                <strong>Sunucu durumu: </strong>

                @if (TcpServer.IsRunning)
                {
                    <span class="badge bg-success">
                        Çalışıyor
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Durduruldu
                    </span>
                }
            </div>

            <div class="mb-3">
                <strong>Bağlı Master sayısı: </strong>

                <span class="badge bg-primary">
                    @TcpServer.ConnectedClientCount
                </span>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-success"
                        @onclick="StartServerAsync"
                        disabled="@(_isBusy || TcpServer.IsRunning)">
                    @if (_isBusy && !TcpServer.IsRunning)
                    {
                        <span>Başlatılıyor...</span>
                    }
                    else
                    {
                        <span>Sunucuyu Başlat</span>
                    }
                </button>

                <button class="btn btn-danger"
                        @onclick="StopServerAsync"
                        disabled="@(_isBusy || !TcpServer.IsRunning)">
                    Sunucuyu Durdur
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3"
                     role="alert">
                    @_message
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    Ayrıştırılan Modbus TCP İstekleri
                </h5>

                <button class="btn btn-sm btn-outline-danger"
                        @onclick="ClearModbusFrames"
                        disabled="@(_modbusFrames.Count == 0)">
                    Listeyi Temizle
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_modbusFrameError))
            {
                <div class="alert alert-danger mt-3" role="alert">
                    @_modbusFrameError
                </div>
            }

            @if (_modbusFrames.Count == 0)
            {
                <div class="alert alert-secondary mt-3 mb-0">
                    Henüz eksiksiz bir Modbus TCP isteği alınmadı.
                </div>
            }
            else
            {
                @foreach (ModbusFrameRecord item in _modbusFrames)
                {
                    <div class="border rounded p-3 mt-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>
                                Function Code:
                                0x@(item.Frame.FunctionCode.ToString("X2"))
                                — @GetFunctionName(item.Frame.FunctionCode)
                            </strong>

                            <small class="text-muted">
                                @item.ReceivedAt.ToString("HH:mm:ss")
                            </small>
                        </div>

                        <div class="row mt-3 g-3">
                            <div class="col-md-4">
                                <strong>Transaction ID:</strong>
                                @item.Frame.TransactionId
                            </div>

                            <div class="col-md-4">
                                <strong>Protocol ID:</strong>
                                @item.Frame.ProtocolId
                            </div>

                            <div class="col-md-4">
                                <strong>Unit ID:</strong>
                                @item.Frame.UnitId
                            </div>

                            <div class="col-md-4">
                                <strong>MBAP Length:</strong>
                                @item.Frame.Length
                            </div>

                            <div class="col-md-4">
                                <strong>Toplam uzunluk:</strong>
                                @item.Frame.TotalByteCount byte
                            </div>

                            <div class="col-md-4">
                                <strong>Master kimliği:</strong>
                                <span class="font-monospace">
                                    @(item.ClientId.ToString()[..8])
                                </span>
                            </div>
                        </div>
                        @if (item.StartAddress.HasValue && item.Quantity.HasValue)
                        {
                            <div class="row mt-1 g-3">
                                <div class="col-md-6">
                                    <strong>Başlangıç register adresi:</strong>
                                    @item.StartAddress.Value
                                </div>

                                <div class="col-md-6">
                                    <strong>Register miktarı:</strong>
                                    @item.Quantity.Value
                                </div>
                            </div>
                        }

                        <div class="mt-3">
                            <strong>Tam paket (HEX):</strong>

                            <div class="bg-dark text-light border rounded p-2 mt-1 font-monospace">
                                @item.Frame.Hex
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    Gelen TCP Verileri
                </h5>

                <button class="btn btn-sm btn-outline-danger"
                        @onclick="ClearReceivedData"
                        disabled="@(_receivedItems.Count == 0)">
                    Listeyi Temizle
                </button>
            </div>

            @if (_receivedItems.Count == 0)
            {
                <div class="alert alert-secondary mt-3 mb-0">
                    Henüz veri alınmadı.
                </div>
            }
            else
            {
                @foreach (ReceivedTcpDataItem item in _receivedItems)
                {
                    <div class="border rounded p-3 mt-3">
                        <div class="d-flex justify-content-between">
                            <strong>Master: @item.ClientName</strong>

                            <small class="text-muted">
                                @item.ReceivedAt.ToString("HH:mm:ss")
                            </small>
                        </div>

                        <div class="mt-3">
                            <strong>Metin:</strong>

                            <div class="bg-light border rounded p-2 mt-1">
                                @item.Text
                            </div>
                        </div>

                        <div class="mt-3">
                            <strong>HEX:</strong>

                            <div class="bg-dark text-light border rounded p-2 mt-1 font-monospace">
                                @item.Hex
                            </div>
                        </div>

                        <div class="mt-2 text-muted">
                            Veri uzunluğu: @item.ByteCount byte
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <a class="btn btn-secondary mt-3" href="/">
        Mod Seçimine Dön
    </a>
</div>

@code {
    private IReadOnlyList<ReceivedTcpDataItem> _receivedItems =
        Array.Empty<ReceivedTcpDataItem>();

    private IReadOnlyList<ModbusFrameRecord> _modbusFrames =
        Array.Empty<ModbusFrameRecord>();

    private readonly TcpServerSettings _settings = new()
    {
        IpAddress = "127.0.0.1",
        Port = 1502,
        Backlog = 100,
        ReceiveBufferSize = 4096
    };

    private bool _isBusy;
    private bool _isError;
    private string? _message;
    private string? _modbusFrameError;

    protected override void OnInitialized()
    {
        TcpServer.ServerStateChanged += OnServerStateChanged;
        TcpServer.ClientConnected += OnClientConnected;
        TcpServer.ClientDisconnected += OnClientDisconnected;
        TcpServer.ServerError += OnServerError;

        ReceivedDataStore.DataChanged += OnReceivedDataChanged;

        ModbusFrameStore.DataChanged += OnModbusFrameStoreChanged;

        RefreshReceivedItems();
        RefreshModbusFrames();
    }

    private async Task StartServerAsync()
    {
        if (TcpServer.IsRunning)
        {
            return;
        }

        _isBusy = true;
        _isError = false;
        _message = null;

        try
        {
            await TcpServer.StartAsync(_settings);

            _message =
                $"TCP sunucusu {_settings.IpAddress}:{_settings.Port} " +
                "adresinde başlatıldı.";
        }
        catch (Exception exception)
        {
            _isError = true;
            _message =
                $"Sunucu başlatılamadı: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task StopServerAsync()
    {
        if (!TcpServer.IsRunning)
        {
            return;
        }

        _isBusy = true;
        _isError = false;
        _message = null;

        try
        {
            await TcpServer.StopAsync();

            _message = "TCP sunucusu durduruldu.";
        }
        catch (Exception exception)
        {
            _isError = true;
            _message =
                $"Sunucu durdurulurken hata oluştu: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnServerStateChanged(bool isRunning)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnClientConnected(
        Guid clientId,
        string remoteEndPoint)
    {
        _ = InvokeAsync(() =>
        {
            _isError = false;
            _message = $"Master bağlandı: {remoteEndPoint}";

            StateHasChanged();
        });
    }

    private void OnClientDisconnected(
        Guid clientId,
        string remoteEndPoint)
    {
        _ = InvokeAsync(() =>
        {
            _isError = false;
            _message = $"Master bağlantısı kapandı: {remoteEndPoint}";

            StateHasChanged();
        });
    }

    private void OnServerError(Exception exception)
    {
        _ = InvokeAsync(() =>
        {
            _isError = true;
            _message = $"Sunucu hatası: {exception.Message}";

            StateHasChanged();
        });
    }

    private void OnReceivedDataChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshReceivedItems();
            StateHasChanged();
        });
    }

    private void RefreshReceivedItems()
    {
        _receivedItems = ReceivedDataStore.Items;
    }

    private void ClearReceivedData()
    {
        ReceivedDataStore.Clear();
    }

    private void OnModbusFrameStoreChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshModbusFrames();
            StateHasChanged();
        });
    }

    private void RefreshModbusFrames()
    {
        _modbusFrames = ModbusFrameStore.Items;
        _modbusFrameError = ModbusFrameStore.LastError;
    }

    private void ClearModbusFrames()
    {
        ModbusFrameStore.Clear();
    }

    private static string GetFunctionName(byte functionCode)
    {
        return functionCode switch
        {
            0x01 => "Coil Oku",
            0x02 => "Discrete Input Oku",
            0x03 => "Holding Register Oku",
            0x04 => "Input Register Oku",
            0x05 => "Tek Coil Yaz",
            0x06 => "Tek Holding Register Yaz",
            0x0F => "Çoklu Coil Yaz",
            0x10 => "Çoklu Holding Register Yaz",
            _ => "Bilinmeyen fonksiyon"
        };
    }

    public void Dispose()
    {
        TcpServer.ServerStateChanged -= OnServerStateChanged;
        TcpServer.ClientConnected -= OnClientConnected;
        TcpServer.ClientDisconnected -= OnClientDisconnected;
        TcpServer.ServerError -= OnServerError;

        ReceivedDataStore.DataChanged -= OnReceivedDataChanged;

        ModbusFrameStore.DataChanged -= OnModbusFrameStoreChanged;
    }
}
