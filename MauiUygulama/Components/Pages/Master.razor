@page "/master"
@using System.Text
@using MauiUygulama.Core.Interfaces
@using MauiUygulama.Models

@implements IDisposable

@inject ITcpClientService TcpClient

<PageTitle>Master Modu</PageTitle>

<div class="container mt-4">
    <h1>Master Modu</h1>

    <p class="text-muted">
        Bağlanılacak TCP sunucusunun IP adresini ve portunu giriniz.
    </p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">

            <div class="mb-3">
                <label for="ipAddress" class="form-label">
                    IP Adresi
                </label>

                <input id="ipAddress"
                       class="form-control"
                       type="text"
                       placeholder="127.0.0.1"
                       @bind="_settings.IpAddress"
                       disabled="@(_isBusy || TcpClient.IsConnected)" />
            </div>

            <div class="mb-3">
                <label for="port" class="form-label">
                    Port
                </label>

                <input id="port"
                       class="form-control"
                       type="number"
                       min="1"
                       max="65535"
                       @bind="_settings.Port"
                       disabled="@(_isBusy || TcpClient.IsConnected)" />
            </div>

            <div class="mb-3">
                <strong>Bağlantı durumu: </strong>

                @if (TcpClient.IsConnected)
                {
                    <span class="badge bg-success">
                        Bağlı
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Bağlı Değil
                    </span>
                }
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary"
                        @onclick="ConnectAsync"
                        disabled="@(_isBusy || TcpClient.IsConnected)">
                    @if (_isBusy && !TcpClient.IsConnected)
                    {
                        <span>Bağlanıyor...</span>
                    }
                    else
                    {
                        <span>Bağlan</span>
                    }
                </button>

                <button class="btn btn-danger"
                        @onclick="DisconnectAsync"
                        disabled="@(_isBusy || !TcpClient.IsConnected)">
                    Bağlantıyı Kes
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3"
                     role="alert">
                    @_message
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h5 class="card-title">Deneme Verisi Gönder</h5>

            <div class="mb-3">
                <label for="outgoingText" class="form-label">
                    Gönderilecek Metin
                </label>

                <textarea id="outgoingText"
                          class="form-control"
                          rows="3"
                          @bind="_outgoingText"
                          disabled="@(_isBusy || !TcpClient.IsConnected)">
            </textarea>
            </div>

            <button class="btn btn-primary"
                    @onclick="SendTestDataAsync"
                    disabled="@(_isBusy ||
                                            !TcpClient.IsConnected ||
                                            string.IsNullOrWhiteSpace(_outgoingText))">
                Veriyi Gönder
            </button>

            @if (!string.IsNullOrWhiteSpace(_lastSentHex))
            {
                <div class="mt-3">
                    <strong>Gönderilen HEX:</strong>

                    <div class="border rounded bg-light p-2 mt-1 font-monospace">
                        @_lastSentHex
                    </div>
                </div>
            }
        </div>
    </div>


    <a class="btn btn-secondary mt-3" href="/">
        Mod Seçimine Dön
    </a>
</div>

@code {

    private string _outgoingText = "Merhaba Slave";
    private string? _lastSentHex;

    private readonly TcpConnectionSettings _settings = new()
    {
        IpAddress = "127.0.0.1",
        Port = 1502,
        ConnectionTimeoutMilliseconds = 5000
    };

    private bool _isBusy;
    private bool _isError;
    private string? _message;

    protected override void OnInitialized()
    {
        TcpClient.ConnectionStateChanged += OnConnectionStateChanged;
    }

    private async Task SendTestDataAsync()
    {
        if (!TcpClient.IsConnected)
        {
            _isError = true;
            _message = "Önce Slave sunucusuna bağlanmalısınız.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_outgoingText))
        {
            _isError = true;
            _message = "Gönderilecek metin boş olamaz.";
            return;
        }

        _isBusy = true;
        _isError = false;
        _message = null;

        try
        {
            byte[] data = Encoding.UTF8.GetBytes(_outgoingText);

            await TcpClient.SendAsync(data);

            _lastSentHex = BitConverter
                .ToString(data)
                .Replace("-", " ");

            _message = $"{data.Length} byte veri gönderildi.";
        }
        catch (Exception exception)
        {
            _isError = true;
            _message = $"Veri gönderilemedi: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ConnectAsync()
    {
        _isBusy = true;
        _isError = false;
        _message = null;

        try
        {
            await TcpClient.ConnectAsync(_settings);

            _message =
                $"{_settings.IpAddress}:{_settings.Port} adresine bağlantı kuruldu.";
        }
        catch (TimeoutException exception)
        {
            _isError = true;
            _message = exception.Message;
        }
        catch (Exception exception)
        {
            _isError = true;
            _message = $"Bağlantı kurulamadı: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DisconnectAsync()
    {
        _isBusy = true;
        _isError = false;
        _message = null;

        try
        {
            await TcpClient.DisconnectAsync();

            _message = "TCP bağlantısı kapatıldı.";
        }
        catch (Exception exception)
        {
            _isError = true;
            _message = $"Bağlantı kapatılırken hata oluştu: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnConnectionStateChanged(bool isConnected)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TcpClient.ConnectionStateChanged -= OnConnectionStateChanged;
    }
}