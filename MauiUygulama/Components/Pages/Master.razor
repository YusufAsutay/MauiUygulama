@page "/master"
@using MauiUygulama.Core.Interfaces
@using MauiUygulama.Models

@implements IDisposable

@inject IModbusMasterService ModbusMaster
@inject IModbusPollingService Polling
@inject IModbusMasterResponseStore ResponseStore

<PageTitle>Modbus TCP Master</PageTitle>

<div class="modbus-page">
    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <span class="page-eyebrow">MASTER ÇALIŞMA ALANI</span>
            <h1 class="mb-1">Master Kontrol Merkezi</h1>
            <p class="mb-0">Tek seferlik işlemleri ve otomatik okumaları ayrı çalışma alanlarında yönetin.</p>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-2">
            <span class="connection-pill @(ModbusMaster.IsConnected ? "is-online" : "is-offline")">
                <span class="status-dot"></span>
                @(ModbusMaster.IsConnected ? "Slave'e bağlı" : "Bağlantı yok")
            </span>
        </div>
    </div>

    <div class="card surface-card connection-card mt-4">
        <div class="card-body">
            <div class="section-title-row">
                <div>
                    <span class="section-eyebrow">BAĞLANTI</span>
                    <h2>Slave Bağlantısı</h2>
                </div>
                <span class="protocol-badge">TCP · FC01 · FC03 · FC06</span>
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-lg-5 col-md-6">
                    <div class="mb-3">
                        <label for="ipAddress" class="form-label">IP Adresi</label>
                        <input id="ipAddress"
                               class="form-control"
                               type="text"
                               placeholder="127.0.0.1"
                               @bind="_settings.IpAddress"
                               disabled="@(_isBusy || ModbusMaster.IsConnected)" />
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <div class="mb-3">
                        <label for="port" class="form-label">Port</label>
                        <input id="port"
                               class="form-control"
                               type="number"
                               min="1"
                               max="65535"
                               @bind="_settings.Port"
                               disabled="@(_isBusy || ModbusMaster.IsConnected)" />
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <div class="connection-summary mb-3">
                        <small>Bağlantı durumu</small>
                        <strong>@(ModbusMaster.IsConnected ? "Bağlı" : "Bağlı değil")</strong>
                        <span>@_settings.IpAddress:@_settings.Port</span>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="d-flex gap-2 mb-3 connection-actions">
                        <button class="btn btn-primary"
                                @onclick="ConnectAsync"
                                disabled="@(_isBusy || ModbusMaster.IsConnected)">
                            @(_isBusy && !ModbusMaster.IsConnected
                                ? "Bağlanıyor..."
                                : "Bağlan")
                        </button>

                        <button class="btn btn-danger"
                                @onclick="DisconnectAsync"
                                disabled="@(_isBusy || !ModbusMaster.IsConnected)">
                            Bağlantıyı Kes
                        </button>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="alert @GetMessageAlertClass() mt-3"
                     role="alert">
                    @_message
                </div>
            }
        </div>
    </div>

    <div class="workspace-tabs"
         role="tablist"
         aria-label="Master çalışma türü">
        <button type="button"
                class="@GetTabCssClass(MasterViewTab.Manual)"
                role="tab"
                aria-selected="@(_activeTab == MasterViewTab.Manual)"
                @onclick="() => _activeTab = MasterViewTab.Manual">
            Manuel İşlem
        </button>

        <button type="button"
                class="@GetTabCssClass(MasterViewTab.Polling)"
                role="tab"
                aria-selected="@(_activeTab == MasterViewTab.Polling)"
                @onclick="() => _activeTab = MasterViewTab.Polling">
            @if (Polling.Status.IsRunning)
            {
                <span class="workspace-tab-status" aria-hidden="true"></span>
            }
            Polling
        </button>
    </div>

    @if (_activeTab == MasterViewTab.Polling)
    {
        <div class="card surface-card polling-card mt-4"
             role="tabpanel">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="section-eyebrow">OTOMATİK OKUMA</span>
                        <h2 class="card-title mb-0">Polling</h2>
                    </div>

                    @if (Polling.Status.IsRunning)
                    {
                        <span class="connection-pill is-online"><span class="status-dot"></span>Çalışıyor</span>
                    }
                    else
                    {
                        <span class="connection-pill is-idle"><span class="status-dot"></span>Durduruldu</span>
                    }
                </div>

                <p class="text-muted mt-2">
                    FC01 veya FC03 isteğini belirlenen aralıkla otomatik gönderir.
                    FC06 yazma işlemi güvenlik nedeniyle polling'e alınmaz.
                </p>

                <div class="row">
                    <div class="col-md-2 mb-3">
                        <label for="pollingFunction" class="form-label">
                            Okuma Fonksiyonu
                        </label>
                        <select id="pollingFunction"
                                class="form-select"
                                @bind="_pollingSettings.FunctionCode"
                                disabled="@(Polling.Status.IsRunning || _isPollingActionBusy)">
                            <option value="1">FC01 — Read Coils</option>
                            <option value="3">FC03 — Read Holding Registers</option>
                        </select>
                    </div>

                    <div class="col-md-2 mb-3">
                        <label for="pollingUnitId" class="form-label">Unit ID</label>
                        <input id="pollingUnitId"
                               class="form-control"
                               type="number"
                               min="0"
                               max="255"
                               @bind="_pollingSettings.UnitId"
                               disabled="@(Polling.Status.IsRunning || _isPollingActionBusy)" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label for="pollingAddress" class="form-label">
                            Başlangıç Adresi
                        </label>
                        <input id="pollingAddress"
                               class="form-control"
                               type="number"
                               min="0"
                               max="65535"
                               @bind="_pollingSettings.StartingAddress"
                               disabled="@(Polling.Status.IsRunning || _isPollingActionBusy)" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label for="pollingQuantity" class="form-label">Miktar</label>
                        <input id="pollingQuantity"
                               class="form-control"
                               type="number"
                               min="1"
                               max="@PollingMaximumQuantity"
                               @bind="_pollingSettings.Quantity"
                               disabled="@(Polling.Status.IsRunning || _isPollingActionBusy)" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label for="pollingInterval" class="form-label">
                            Polling Aralığı (ms)
                        </label>
                        <input id="pollingInterval"
                               class="form-control"
                               type="number"
                               min="200"
                               max="60000"
                               step="100"
                               @bind="_pollingSettings.IntervalMilliseconds"
                               disabled="@(Polling.Status.IsRunning || _isPollingActionBusy)" />
                    </div>

                    <div class="col-12">
                        <details class="advanced-settings mb-3">
                            <summary>Gelişmiş Ayarlar</summary>
                            <div class="advanced-settings-body">
                                <div class="advanced-field">
                                    <label for="pollingTimeout" class="form-label">
                                        Her okuma için zaman aşımı (ms)
                                    </label>
                                    <input id="pollingTimeout"
                                           class="form-control"
                                           type="number"
                                           min="100"
                                           max="60000"
                                           step="100"
                                           @bind="_pollingSettings.RequestTimeoutMilliseconds"
                                           disabled="@(Polling.Status.IsRunning || _isPollingActionBusy)" />
                                </div>
                                <p class="advanced-help mb-0">
                                    FC06 yazma işlemi güvenlik nedeniyle polling'e alınmaz.
                                </p>
                            </div>
                        </details>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-success"
                            @onclick="StartPollingAsync"
                            disabled="@(_isPollingActionBusy || Polling.Status.IsRunning || !ModbusMaster.IsConnected)">
                        @(_isPollingActionBusy && !Polling.Status.IsRunning
                            ? "Başlatılıyor..."
                            : "Polling'i Başlat")
                    </button>

                    <button class="btn btn-outline-danger"
                            @onclick="StopPollingAsync"
                            disabled="@(_isPollingActionBusy || !Polling.Status.IsRunning)">
                        Polling'i Durdur
                    </button>
                </div>

                <div class="row g-2 mt-3 metric-row">
                    <div class="col-md-2">
                        <div class="metric-card h-100">
                            <small class="text-muted d-block">Başarılı okuma</small>
                            <strong>@Polling.Status.SuccessfulPollCount</strong>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="metric-card h-100">
                            <small class="text-muted d-block">Hatalı okuma</small>
                            <strong>@Polling.Status.FailedPollCount</strong>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="metric-card h-100">
                            <small class="text-muted d-block">Timeout</small>
                            <strong>@Polling.Status.TimedOutPollCount</strong>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="metric-card h-100">
                            <small class="text-muted d-block">Son başarılı okuma</small>
                            <strong>@FormatPollingTime(Polling.Status.LastSuccessfulPollAt)</strong>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="metric-card h-100">
                            <small class="text-muted d-block">Aktif ayar</small>
                            <strong>@GetPollingSummary(Polling.Status)</strong>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Polling.Status.LastError))
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">
                        <strong>Son polling hatası:</strong> @Polling.Status.LastError
                    </div>
                }

                @if (Polling.Status.LastResult is ModbusMasterOperationResult pollingResult)
                {
                    <div class="mt-3">
                        <strong>Son polling isteği:</strong>
                        <div class="border rounded bg-dark text-light p-2 mt-1 font-monospace">
                            @pollingResult.RequestHex
                        </div>
                        <div class="mt-2 text-muted">
                            Transaction ID: @pollingResult.TransactionId,
                            Function Code: @pollingResult.FunctionCode.ToString("X2")
                        </div>
                    </div>
                }

                <div class="alert alert-info mt-3 mb-0">
                    Polling sayfa geçişlerinde çalışmaya devam eder. Master ekranına
                    döndüğünüzde sayaçlar ve son sonuç korunur.
                </div>
            </div>
        </div>

    }
    else
    {
        <div class="card surface-card operation-card mt-4"
             role="tabpanel">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="section-eyebrow">MANUEL İŞLEM</span>
                        <h2 class="card-title mb-0">Modbus Komutu</h2>
                    </div>
                    <span class="function-badge">
                        FC@(_selectedFunctionCode.ToString("D2"))
                    </span>
                </div>

                <p class="text-muted mt-2">
                    Okuma ve yazma işlemleri güvenli Modbus Master servisi üzerinden yürütülür.
                </p>

                @if (!string.IsNullOrWhiteSpace(_manualMessage) &&
                    (_isManualError || _isManualWarning))
                {
                    <div class="alert @GetManualMessageAlertClass() mb-3"
                         role="alert">
                        @_manualMessage
                    </div>
                }

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label for="functionCode" class="form-label">Function ID</label>
                        <select id="functionCode"
                                class="form-select"
                                @bind="_selectedFunctionCode"
                                disabled="@_isBusy">
                            <option value="1">FC01 — Read Coils</option>
                            <option value="3">FC03 — Read Holding Registers</option>
                            <option value="6">FC06 — Write Single Register</option>
                        </select>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label for="unitId" class="form-label">Unit ID</label>
                        <input id="unitId"
                               class="form-control"
                               type="number"
                               min="0"
                               max="255"
                               @bind="_unitId"
                               disabled="@(_isBusy || !ModbusMaster.IsConnected)" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label for="operationAddress" class="form-label">
                            @AddressLabel
                        </label>
                        <input id="operationAddress"
                               class="form-control"
                               type="number"
                               min="0"
                               max="65535"
                               @bind="_operationAddress"
                               disabled="@(_isBusy || !ModbusMaster.IsConnected)" />
                    </div>

                    <div class="col-md-3 mb-3">
                        @if (_selectedFunctionCode == WriteSingleRegisterFunctionCode)
                        {
                            <label for="writeValue" class="form-label">
                                Yazılacak Değer
                            </label>
                            <input id="writeValue"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   max="65535"
                                   @bind="_writeValue"
                                   disabled="@(_isBusy || !ModbusMaster.IsConnected)" />
                        }
                        else
                        {
                            <label for="quantity" class="form-label">
                                @QuantityLabel
                            </label>
                            <input id="quantity"
                                   class="form-control"
                                   type="number"
                                   min="1"
                                   max="@MaximumQuantity"
                                   @bind="_quantity"
                                   disabled="@(_isBusy || !ModbusMaster.IsConnected)" />
                        }
                    </div>
                </div>

                <details class="advanced-settings mb-3">
                    <summary>Gelişmiş Ayarlar</summary>
                    <div class="advanced-settings-body">
                        <div class="advanced-field">
                            <label for="requestTimeout" class="form-label">
                                İstek zaman aşımı (ms)
                            </label>
                            <input id="requestTimeout"
                                   class="form-control"
                                   type="number"
                                   min="100"
                                   max="60000"
                                   step="100"
                                   @bind="_requestOptions.TimeoutMilliseconds"
                                   disabled="@(_isBusy || !ModbusMaster.IsConnected)" />
                        </div>
                        <p class="advanced-help mb-0">
                            Her manuel istek için ayrı uygulanır. Varsayılan değer 3000 ms'dir.
                        </p>
                    </div>
                </details>

                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary"
                            @onclick="SendSelectedOperationAsync"
                            disabled="@(_isBusy || !ModbusMaster.IsConnected)">
                        @(_isManualOperationRunning
                            ? "Cevap bekleniyor..."
                            : "İşlemi Gönder")
                    </button>

                    @if (_isManualOperationRunning)
                    {
                        <button class="btn btn-outline-warning"
                                @onclick="CancelManualOperation">
                            İsteği İptal Et
                        </button>
                    }
                </div>

                @if (_isManualOperationRunning)
                {
                    <div class="alert alert-info mt-3 mb-0">
                        Slave cevabı bekleniyor. İstek en fazla
                        @_requestOptions.TimeoutMilliseconds ms bekleyecek.
                    </div>
                }

            </div>
        </div>

        <div class="card surface-card results-card mt-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="section-eyebrow">CEVAPLAR</span>
                        <h2 class="card-title mb-0">İşlem Sonuçları</h2>
                    </div>
                    <button class="btn btn-sm btn-outline-danger"
                            @onclick="ClearModbusResponses"
                            disabled="@(ResponseStore.Items.Count == 0)">
                        Listeyi Temizle
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_manualMessage) &&
                    !_isManualError &&
                    !_isManualWarning)
                {
                    <div class="alert alert-success mt-3 mb-0" role="status">
                        @_manualMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_lastModbusRequestHex))
                {
                    <div class="border rounded p-3 mt-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <strong>Son Gönderilen İstek</strong>
                            <span class="function-badge">
                                FC@(_lastFunctionCode.ToString("D2"))
                            </span>
                        </div>
                        <div class="border rounded bg-dark text-light p-2 mt-2 font-monospace">
                            @_lastModbusRequestHex
                        </div>
                        <div class="mt-2 text-muted">
                            Transaction ID: @_lastTransactionId,
                            Function Code: @_lastFunctionCode.ToString("X2"),
                            Toplam: 12 byte
                        </div>
                    </div>
                }

                @if (ResponseStore.Items.Count == 0)
                {
                    <div class="alert alert-secondary mt-3 mb-0">
                        Henüz Slave tarafından bir Modbus cevabı alınmadı.
                    </div>
                }
                else
                {
                    @foreach (ModbusMasterResponseRecord response in ResponseStore.Items)
                    {
                        <div class="border rounded p-3 mt-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>Transaction ID: @response.TransactionId</strong>
                                <small class="text-muted">
                                    @response.ReceivedAt.ToString("HH:mm:ss")
                                </small>
                            </div>

                            <div class="row mt-2 g-2">
                                <div class="col-md-4">
                                    <strong>Unit ID:</strong> @response.UnitId
                                </div>
                                <div class="col-md-4">
                                    <strong>Function Code:</strong>
                                    @response.FunctionCode.ToString("X2")
                                    — @GetFunctionName(response.FunctionCode)
                                </div>
                                <div class="col-md-4">
                                    @if (response.FunctionCode == WriteSingleRegisterFunctionCode)
                                    {
                                        <strong>Yazılan değer:</strong>
                                        @response.RegisterValues[0]
                                    }
                                    else
                                    {
                                        <strong>@(GetResultCountLabel(response.FunctionCode)):</strong>
                                        @response.RegisterValues.Length
                                    }
                                </div>
                            </div>

                            <div class="table-responsive mt-3">
                                <table class="table table-sm table-bordered align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Sıra</th>
                                            <th>@GetResultAddressLabel(response.FunctionCode)</th>
                                            <th>Değer</th>
                                            <th>Değer (HEX)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int index = 0;
                                            index < response.RegisterValues.Length;
                                            index++)
                                        {
                                            ushort value = response.RegisterValues[index];

                                            <tr>
                                                <td>@(index + 1)</td>
                                                <td>@GetRegisterAddress(response, index)</td>
                                                <td>
                                                    @if (response.FunctionCode == ReadCoilsFunctionCode)
                                                    {
                                                        <span class="badge @(value == 0 ? "bg-secondary" : "bg-success")">
                                                            @(value == 0 ? "0 / OFF" : "1 / ON")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @value
                                                    }
                                                </td>
                                                <td class="font-monospace">
                                                    0x@(value.ToString("X4"))
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="mt-3">
                                <strong>Alınan cevap (HEX):</strong>
                                <div class="border rounded bg-dark text-light p-2 mt-1 font-monospace">
                                    @response.Hex
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }

</div>

@code {
    private const byte ReadCoilsFunctionCode = 0x01;
    private const byte ReadHoldingRegistersFunctionCode = 0x03;
    private const byte WriteSingleRegisterFunctionCode = 0x06;

    private MasterViewTab _activeTab = MasterViewTab.Manual;

    private readonly TcpConnectionSettings _settings = new()
    {
        IpAddress = "127.0.0.1",
        Port = 1502,
        ConnectionTimeoutMilliseconds = 5000
    };

    private readonly ModbusPollingSettings _pollingSettings = new()
    {
        FunctionCode = ReadHoldingRegistersFunctionCode,
        UnitId = 1,
        StartingAddress = 101,
        Quantity = 1,
        IntervalMilliseconds = 1000,
        RequestTimeoutMilliseconds = 3000
    };

    private readonly ModbusRequestOptions _requestOptions = new()
    {
        TimeoutMilliseconds = 3000
    };

    private byte _selectedFunctionCode = ReadHoldingRegistersFunctionCode;
    private byte _unitId = 1;
    private ushort _operationAddress;
    private ushort _quantity = 10;
    private ushort _writeValue;

    private ushort _lastTransactionId;
    private byte _lastFunctionCode;
    private string? _lastModbusRequestHex;
    private bool _isBusy;
    private bool _isManualOperationRunning;
    private bool _isPollingActionBusy;
    private bool _isError;
    private bool _isWarning;
    private string? _message;
    private bool _isManualError;
    private bool _isManualWarning;
    private string? _manualMessage;
    private CancellationTokenSource? _manualOperationCancellation;

    private enum MasterViewTab
    {
        Manual,
        Polling
    }

    private string GetTabCssClass(MasterViewTab tab)
    {
        return _activeTab == tab
            ? "workspace-tab is-active"
            : "workspace-tab";
    }

    protected override void OnInitialized()
    {
        LoadPollingSettingsFromStatus();

        ModbusMaster.ConnectionStateChanged += OnConnectionStateChanged;
        Polling.StatusChanged += OnPollingStatusChanged;
        ResponseStore.DataChanged += OnResponseStoreChanged;
    }

    private void LoadPollingSettingsFromStatus()
    {
        ModbusPollingStatus status = Polling.Status;

        if (status.StartedAt is null)
        {
            return;
        }

        _pollingSettings.FunctionCode = status.FunctionCode;
        _pollingSettings.UnitId = status.UnitId;
        _pollingSettings.StartingAddress = status.StartingAddress;
        _pollingSettings.Quantity = status.Quantity;
        _pollingSettings.IntervalMilliseconds = status.IntervalMilliseconds;
        _pollingSettings.RequestTimeoutMilliseconds =
            status.RequestTimeoutMilliseconds;
    }

    private string AddressLabel =>
        _selectedFunctionCode == ReadCoilsFunctionCode
            ? "Başlangıç Coil Adresi"
            : "Register Adresi";

    private string QuantityLabel =>
        _selectedFunctionCode == ReadCoilsFunctionCode
            ? "Coil Miktarı"
            : "Register Miktarı";

    private int MaximumQuantity =>
        _selectedFunctionCode == ReadCoilsFunctionCode
            ? 2000
            : 125;

    private int PollingMaximumQuantity =>
        _pollingSettings.FunctionCode == ReadCoilsFunctionCode
            ? 2000
            : 125;

    private async Task ConnectAsync()
    {
        await RunUiOperationAsync(
            async () =>
            {
                await ModbusMaster.ConnectAsync(_settings);
                _message =
                    $"{_settings.IpAddress}:{_settings.Port} adresine bağlantı kuruldu.";
            },
            "Bağlantı kurulamadı");
    }

    private async Task DisconnectAsync()
    {
        await RunUiOperationAsync(
            async () =>
            {
                await Polling.StopAsync();
                await ModbusMaster.DisconnectAsync();
                _message = "TCP bağlantısı kapatıldı.";
            },
            "Bağlantı kapatılırken hata oluştu");
    }

    private async Task StartPollingAsync()
    {
        _isPollingActionBusy = true;
        _isError = false;
        _isWarning = false;
        _message = null;

        try
        {
            await Polling.StartAsync(_pollingSettings);
            _message =
                $"Polling başlatıldı: FC{_pollingSettings.FunctionCode:X2}, " +
                $"adres {_pollingSettings.StartingAddress}, " +
                $"miktar {_pollingSettings.Quantity}, " +
                $"aralık {_pollingSettings.IntervalMilliseconds} ms, " +
                $"timeout {_pollingSettings.RequestTimeoutMilliseconds} ms.";
        }
        catch (Exception exception)
        {
            _isError = true;
            _message = $"Polling başlatılamadı: {exception.Message}";
        }
        finally
        {
            _isPollingActionBusy = false;
        }
    }

    private async Task StopPollingAsync()
    {
        _isPollingActionBusy = true;
        _isError = false;
        _isWarning = false;
        _message = null;

        try
        {
            await Polling.StopAsync();
            _message = "Polling güvenli biçimde durduruldu.";
        }
        catch (Exception exception)
        {
            _isError = true;
            _message = $"Polling durdurulamadı: {exception.Message}";
        }
        finally
        {
            _isPollingActionBusy = false;
        }
    }

    private async Task SendSelectedOperationAsync()
    {
        if (_isManualOperationRunning)
        {
            return;
        }

        var cancellation = new CancellationTokenSource();
        _manualOperationCancellation = cancellation;
        _isBusy = true;
        _isManualOperationRunning = true;
        _isManualError = false;
        _isManualWarning = false;
        _manualMessage = null;

        try
        {
            ModbusMasterOperationResult result =
                _selectedFunctionCode switch
                {
                    ReadCoilsFunctionCode =>
                        await ModbusMaster.ReadCoilsAsync(
                            _unitId,
                            _operationAddress,
                            _quantity,
                            _requestOptions,
                            cancellation.Token),

                    ReadHoldingRegistersFunctionCode =>
                        await ModbusMaster.ReadHoldingRegistersAsync(
                            _unitId,
                            _operationAddress,
                            _quantity,
                            _requestOptions,
                            cancellation.Token),

                    WriteSingleRegisterFunctionCode =>
                        await ModbusMaster.WriteSingleHoldingRegisterAsync(
                            _unitId,
                            _operationAddress,
                            _writeValue,
                            _requestOptions,
                            cancellation.Token),

                    _ => throw new InvalidOperationException(
                        "Desteklenmeyen Function ID seçildi.")
                };

            ShowCompletedOperation(result);
        }
        catch (ModbusRequestTimeoutException exception)
        {
            _isManualError = true;
            _manualMessage =
                $"Modbus isteği zaman aşımına uğradı: {exception.Message}";
        }
        catch (OperationCanceledException)
            when (cancellation.IsCancellationRequested)
        {
            _isManualWarning = true;
            _manualMessage =
                "Modbus isteği kullanıcı tarafından güvenli biçimde iptal edildi.";
        }
        catch (Exception exception)
        {
            _isManualError = true;
            _manualMessage =
                $"Modbus işlemi tamamlanamadı: {exception.Message}";
        }
        finally
        {
            if (ReferenceEquals(_manualOperationCancellation, cancellation))
            {
                _manualOperationCancellation = null;
            }

            cancellation.Dispose();
            _isManualOperationRunning = false;
            _isBusy = false;
        }
    }

    private void CancelManualOperation()
    {
        CancellationTokenSource? cancellation =
            _manualOperationCancellation;

        if (cancellation is null || cancellation.IsCancellationRequested)
        {
            return;
        }

        _isManualWarning = true;
        _manualMessage = "İptal isteği gönderildi; işlem sonlandırılıyor...";
        cancellation.Cancel();
    }

    private async Task RunUiOperationAsync(
        Func<Task> operation,
        string errorPrefix)
    {
        _isBusy = true;
        _isError = false;
        _isWarning = false;
        _message = null;

        try
        {
            await operation();
        }
        catch (Exception exception)
        {
            _isError = true;
            _message = $"{errorPrefix}: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ShowCompletedOperation(ModbusMasterOperationResult result)
    {
        _lastTransactionId = result.TransactionId;
        _lastFunctionCode = result.FunctionCode;
        _lastModbusRequestHex = result.RequestHex;

        _isManualError = false;
        _isManualWarning = false;
        _manualMessage = result.FunctionCode switch
        {
            ReadCoilsFunctionCode =>
                $"FC01 tamamlandı: {result.Response.RegisterValues.Length} Coil okundu.",

            ReadHoldingRegistersFunctionCode =>
                $"FC03 tamamlandı: {result.Response.RegisterValues.Length} " +
                "Holding Register okundu.",

            WriteSingleRegisterFunctionCode =>
                $"FC06 tamamlandı: Holding Register[{result.StartAddress}] = " +
                $"{result.QuantityOrValue}.",

            _ => "Modbus işlemi tamamlandı."
        };
    }

    private void OnConnectionStateChanged(bool isConnected)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnResponseStoreChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnPollingStatusChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ClearModbusResponses()
    {
        ResponseStore.Clear();
    }

    private static int GetRegisterAddress(
        ModbusMasterResponseRecord response,
        int index)
    {
        return response.StartAddress.HasValue
            ? response.StartAddress.Value + index
            : index;
    }

    private static string GetResultCountLabel(byte functionCode)
    {
        return functionCode == ReadCoilsFunctionCode
            ? "Coil miktarı"
            : "Register miktarı";
    }

    private static string GetResultAddressLabel(byte functionCode)
    {
        return functionCode == ReadCoilsFunctionCode
            ? "Coil adresi"
            : "Register adresi";
    }

    private static string GetFunctionName(byte functionCode)
    {
        return functionCode switch
        {
            ReadCoilsFunctionCode => "Read Coils",
            ReadHoldingRegistersFunctionCode => "Holding Register",
            WriteSingleRegisterFunctionCode => "Write Single Holding Register",
            _ => "Bilinmeyen fonksiyon"
        };
    }

    private static string FormatPollingTime(DateTime? value)
    {
        return value?.ToString("HH:mm:ss") ?? "—";
    }

    private string GetMessageAlertClass()
    {
        if (_isError)
        {
            return "alert-danger";
        }

        return _isWarning
            ? "alert-warning"
            : "alert-success";
    }

    private string GetManualMessageAlertClass()
    {
        return _isManualError
            ? "alert-danger"
            : "alert-warning";
    }

    private static string GetPollingSummary(ModbusPollingStatus status)
    {
        if (status.StartedAt is null)
        {
            return "Henüz başlatılmadı";
        }

        return $"FC{status.FunctionCode:X2} · Adres {status.StartingAddress} · " +
            $"{status.Quantity} adet · {status.IntervalMilliseconds} ms · " +
            $"timeout {status.RequestTimeoutMilliseconds} ms";
    }

    public void Dispose()
    {
        try
        {
            _manualOperationCancellation?.Cancel();
        }
        catch (ObjectDisposedException)
        {
            // İşlem aynı anda tamamlandıysa ek işlem gerekmez.
        }

        ModbusMaster.ConnectionStateChanged -= OnConnectionStateChanged;
        Polling.StatusChanged -= OnPollingStatusChanged;
        ResponseStore.DataChanged -= OnResponseStoreChanged;
    }
}
