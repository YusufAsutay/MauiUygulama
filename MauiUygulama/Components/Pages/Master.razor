@* Güncel merkezî Master işlem ekranı — 06.08.2026 *@
@page "/master"
@using MauiUygulama.Core.Interfaces
@using MauiUygulama.Models

@implements IDisposable

@inject ITcpClientService TcpClient
@inject IModbusMasterResponseStore ResponseStore

<PageTitle>Merkezî Master Modu</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h1 class="mb-0">Merkezî Master Modu</h1>

        <span class="badge bg-dark">
            FC01 · FC03 · FC06
        </span>
    </div>

    <p class="text-muted mt-2">
        TCP bağlantısı ve bütün Modbus işlemleri bu ekran üzerinden yönetilir.
    </p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">

            <div class="mb-3">
                <label for="ipAddress" class="form-label">
                    IP Adresi
                </label>

                <input id="ipAddress"
                       class="form-control"
                       type="text"
                       placeholder="127.0.0.1"
                       @bind="_settings.IpAddress"
                       disabled="@(_isBusy || TcpClient.IsConnected)" />
            </div>

            <div class="mb-3">
                <label for="port" class="form-label">
                    Port
                </label>

                <input id="port"
                       class="form-control"
                       type="number"
                       min="1"
                       max="65535"
                       @bind="_settings.Port"
                       disabled="@(_isBusy || TcpClient.IsConnected)" />
            </div>

            <div class="mb-3">
                <strong>Bağlantı durumu: </strong>

                @if (TcpClient.IsConnected)
                {
                    <span class="badge bg-success">
                        Bağlı
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Bağlı Değil
                    </span>
                }
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary"
                        @onclick="ConnectAsync"
                        disabled="@(_isBusy || TcpClient.IsConnected)">
                    @if (_isBusy && !TcpClient.IsConnected)
                    {
                        <span>Bağlanıyor...</span>
                    }
                    else
                    {
                        <span>Bağlan</span>
                    }
                </button>

                <button class="btn btn-danger"
                        @onclick="DisconnectAsync"
                        disabled="@(_isBusy || !TcpClient.IsConnected)">
                    Bağlantıyı Kes
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3"
                     role="alert">
                    @_message
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="card-title mb-0">Modbus İşlemi</h5>

                <span class="badge bg-primary">
                    Function @_selectedFunctionCode.ToString("X2")
                </span>
            </div>

            <p class="text-muted mt-2">
                Okuma ve yazma işlemleri bu tek panelden yönetilir.
            </p>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label for="functionCode" class="form-label">
                        Function ID
                    </label>

                    <select id="functionCode"
                            class="form-select"
                            @bind="_selectedFunctionCode"
                            disabled="@_isBusy">
                        <option value="1">01 — Read Coils</option>
                        <option value="3">03 — Read Holding Registers</option>
                        <option value="6">06 — Write Single Register</option>
                    </select>
                </div>

                <div class="col-md-3 mb-3">
                    <label for="unitId" class="form-label">
                        Unit ID
                    </label>

                    <input id="unitId"
                           class="form-control"
                           type="number"
                           min="0"
                           max="255"
                           @bind="_unitId"
                           disabled="@(_isBusy || !TcpClient.IsConnected)" />
                </div>

                <div class="col-md-3 mb-3">
                    <label for="operationAddress" class="form-label">
                        @AddressLabel
                    </label>

                    <input id="operationAddress"
                           class="form-control"
                           type="number"
                           min="0"
                           max="65535"
                           @bind="_operationAddress"
                           disabled="@(_isBusy || !TcpClient.IsConnected)" />
                </div>

                <div class="col-md-3 mb-3">
                    @if (_selectedFunctionCode == WriteSingleRegisterFunctionCode)
                    {
                        <label for="writeValue" class="form-label">
                            Yazılacak Değer
                        </label>

                        <input id="writeValue"
                               class="form-control"
                               type="number"
                               min="0"
                               max="65535"
                               @bind="_writeValue"
                               disabled="@(_isBusy || !TcpClient.IsConnected)" />
                    }
                    else
                    {
                        <label for="quantity" class="form-label">
                            @QuantityLabel
                        </label>

                        <input id="quantity"
                               class="form-control"
                               type="number"
                               min="1"
                               max="@MaximumQuantity"
                               @bind="_quantity"
                               disabled="@(_isBusy || !TcpClient.IsConnected)" />
                    }
                </div>
            </div>

            @if (!IsSelectedFunctionImplemented)
            {
                <div class="alert alert-info">
                    @SelectedFunctionName için merkezî arayüz hazırlandı.
                    Haberleşme kodu sonraki adımda eklenecek.
                </div>
            }

            <button class="btn btn-primary"
                    @onclick="SendSelectedOperationAsync"
                    disabled="@(_isBusy ||
                                                !TcpClient.IsConnected ||
                                                !IsSelectedFunctionImplemented)">
                İşlemi Gönder
            </button>

            @if (!string.IsNullOrWhiteSpace(_lastModbusRequestHex))
            {
                <div class="mt-3">
                    <strong>Gönderilen Modbus TCP isteği:</strong>

                    <div class="border rounded bg-dark text-light p-2 mt-1 font-monospace">
                        @_lastModbusRequestHex
                    </div>

                    <div class="mt-2 text-muted">
                        Transaction ID: @_lastTransactionId,
                        Function Code: @_lastFunctionCode.ToString("X2"),
                        Toplam: 12 byte
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    İşlem Sonuçları
                </h5>

                <button class="btn btn-sm btn-outline-danger"
                        @onclick="ClearModbusResponses"
                        disabled="@(ResponseStore.Items.Count == 0)">
                    Listeyi Temizle
                </button>
            </div>

            @if (ResponseStore.Items.Count == 0)
            {
                <div class="alert alert-secondary mt-3 mb-0">
                    Henüz Slave tarafından bir Modbus cevabı alınmadı.
                </div>
            }
            else
            {
                @foreach (ModbusMasterResponseRecord response in ResponseStore.Items)
                {
                    <div class="border rounded p-3 mt-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>
                                Transaction ID: @response.TransactionId
                            </strong>

                            <small class="text-muted">
                                @response.ReceivedAt.ToString("HH:mm:ss")
                            </small>
                        </div>

                        <div class="row mt-2 g-2">
                            <div class="col-md-4">
                                <strong>Unit ID:</strong>
                                @response.UnitId
                            </div>

                            <div class="col-md-4">
                                <strong>Function Code:</strong>
                                @response.FunctionCode.ToString("X2")
                                — @GetFunctionName(response.FunctionCode)
                            </div>

                            <div class="col-md-4">
                                <strong>Register miktarı:</strong>
                                @response.RegisterValues.Length
                            </div>
                        </div>

                        <div class="table-responsive mt-3">
                            <table class="table table-sm table-bordered align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Sıra</th>
                                        <th>Register adresi</th>
                                        <th>Değer (Decimal)</th>
                                        <th>Değer (HEX)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int index = 0;
                                        index < response.RegisterValues.Length;
                                        index++)
                                    {
                                        ushort value = response.RegisterValues[index];

                                        <tr>
                                            <td>@(index + 1)</td>
                                            <td>@GetRegisterAddress(response, index)</td>
                                            <td>@value</td>
                                            <td class="font-monospace">
                                                0x@(value.ToString("X4"))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <strong>Alınan cevap (HEX):</strong>

                            <div class="border rounded bg-dark text-light p-2 mt-1 font-monospace">
                                @response.Hex
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <a class="btn btn-secondary mt-3" href="/">
        Mod Seçimine Dön
    </a>
</div>

@code {
    private const byte ReadCoilsFunctionCode = 0x01;
    private const byte ReadHoldingRegistersFunctionCode = 0x03;
    private const byte WriteSingleRegisterFunctionCode = 0x06;

    private byte _selectedFunctionCode = ReadHoldingRegistersFunctionCode;
    private byte _unitId = 1;
    private ushort _operationAddress;
    private ushort _quantity = 10;
    private ushort _writeValue;
    private ushort _nextTransactionId = 1;
    private ushort _lastTransactionId;
    private byte _lastFunctionCode;
    private string? _lastModbusRequestHex;

    private readonly Dictionary<ushort, PendingReadRequest> _pendingReadRequests = new();
    private readonly object _pendingRequestsLock = new();
    private CancellationTokenSource? _receiveCancellation;

    private readonly TcpConnectionSettings _settings = new()
    {
        IpAddress = "127.0.0.1",
        Port = 1502,
        ConnectionTimeoutMilliseconds = 5000
    };

    private bool _isBusy;
    private bool _isError;
    private string? _message;

    protected override void OnInitialized()
    {
        TcpClient.ConnectionStateChanged += OnConnectionStateChanged;
        ResponseStore.DataChanged += OnResponseStoreChanged;

        if (TcpClient.IsConnected)
        {
            StartReceiveLoop();
        }
    }

    private bool IsSelectedFunctionImplemented =>
        _selectedFunctionCode == ReadHoldingRegistersFunctionCode;

    private string SelectedFunctionName =>
        GetFunctionName(_selectedFunctionCode);

    private string AddressLabel =>
        _selectedFunctionCode == ReadCoilsFunctionCode
            ? "Başlangıç Coil Adresi"
            : "Register Adresi";

    private string QuantityLabel =>
        _selectedFunctionCode == ReadCoilsFunctionCode
            ? "Coil Miktarı"
            : "Register Miktarı";

    private int MaximumQuantity =>
        _selectedFunctionCode == ReadCoilsFunctionCode
            ? 2000
            : 125;

    private async Task SendSelectedOperationAsync()
    {
        switch (_selectedFunctionCode)
        {
            case ReadHoldingRegistersFunctionCode:
                await SendReadRegistersRequestAsync(
                    _operationAddress,
                    _quantity);
                break;

            case ReadCoilsFunctionCode:
            case WriteSingleRegisterFunctionCode:
                _isError = false;
                _message =
                    $"{SelectedFunctionName} haberleşmesi sonraki adımda eklenecek.";
                break;

            default:
                _isError = true;
                _message = "Desteklenmeyen Function ID seçildi.";
                break;
        }
    }

    private async Task SendReadRegistersRequestAsync(
        ushort startingAddress,
        ushort registerQuantity)
    {
        if (!TcpClient.IsConnected)
        {
            _isError = true;
            _message = "Önce Slave sunucusuna bağlanmalısınız.";
            return;
        }

        if (registerQuantity is < 1 or > 125)
        {
            _isError = true;
            _message = "Register miktarı 1 ile 125 arasında olmalıdır.";
            return;
        }

        int lastRegisterAddress =
            startingAddress + registerQuantity - 1;

        if (lastRegisterAddress > ushort.MaxValue)
        {
            _isError = true;
            _message =
                "Başlangıç adresi ile register miktarı geçerli adres aralığını aşıyor.";
            return;
        }

        _isBusy = true;
        _isError = false;
        _message = null;

        try
        {
            ushort transactionId = _nextTransactionId;
            _nextTransactionId = transactionId == ushort.MaxValue
                ? (ushort)1
                : (ushort)(transactionId + 1);

            byte[] request = CreateReadRegistersRequest(
                transactionId,
                _unitId,
                ReadHoldingRegistersFunctionCode,
                startingAddress,
                registerQuantity);

            lock (_pendingRequestsLock)
            {
                _pendingReadRequests[transactionId] = new PendingReadRequest(
                    ReadHoldingRegistersFunctionCode,
                    startingAddress,
                    registerQuantity);
            }

            try
            {
                await TcpClient.SendAsync(request);
            }
            catch
            {
                lock (_pendingRequestsLock)
                {
                    _pendingReadRequests.Remove(transactionId);
                }

                throw;
            }

            string requestHex = BitConverter
                .ToString(request)
                .Replace("-", " ");

            _lastTransactionId = transactionId;
            _lastFunctionCode = ReadHoldingRegistersFunctionCode;
            _lastModbusRequestHex = requestHex;

            _message =
                "Function 03 isteği gönderildi. " +
                $"Başlangıç adresi: {startingAddress}, " +
                $"register miktarı: {registerQuantity}.";
        }
        catch (Exception exception)
        {
            _isError = true;
            _message =
                $"Modbus TCP isteği gönderilemedi: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static byte[] CreateReadRegistersRequest(
        ushort transactionId,
        byte unitId,
        byte functionCode,
        ushort startingAddress,
        ushort registerQuantity)
    {
        byte[] request = new byte[12];

        WriteUInt16BigEndian(request, 0, transactionId);
        WriteUInt16BigEndian(request, 2, 0);
        WriteUInt16BigEndian(request, 4, 6);

        request[6] = unitId;
        request[7] = functionCode;

        WriteUInt16BigEndian(request, 8, startingAddress);
        WriteUInt16BigEndian(request, 10, registerQuantity);

        return request;
    }

    private static void WriteUInt16BigEndian(
        byte[] destination,
        int index,
        ushort value)
    {
        destination[index] = (byte)(value >> 8);
        destination[index + 1] = (byte)value;
    }

    private async Task ConnectAsync()
    {
        _isBusy = true;
        _isError = false;
        _message = null;

        try
        {
            await TcpClient.ConnectAsync(_settings);

            StartReceiveLoop();

            _message =
                $"{_settings.IpAddress}:{_settings.Port} adresine bağlantı kuruldu.";
        }
        catch (TimeoutException exception)
        {
            _isError = true;
            _message = exception.Message;
        }
        catch (Exception exception)
        {
            _isError = true;
            _message = $"Bağlantı kurulamadı: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DisconnectAsync()
    {
        _isBusy = true;
        _isError = false;
        _message = null;

        try
        {
            StopReceiveLoop();

            await TcpClient.DisconnectAsync();

            ClearPendingRequests();

            _message = "TCP bağlantısı kapatıldı.";
        }
        catch (Exception exception)
        {
            _isError = true;
            _message =
                $"Bağlantı kapatılırken hata oluştu: {exception.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnConnectionStateChanged(bool isConnected)
    {
        if (!isConnected)
        {
            StopReceiveLoop();
            ClearPendingRequests();
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void StartReceiveLoop()
    {
        StopReceiveLoop();

        _receiveCancellation = new CancellationTokenSource();
        _ = ReceiveLoopAsync(_receiveCancellation.Token);
    }

    private void StopReceiveLoop()
    {
        _receiveCancellation?.Cancel();
        _receiveCancellation = null;
    }

    private async Task ReceiveLoopAsync(CancellationToken cancellationToken)
    {
        byte[] receiveBuffer = new byte[4096];
        var pendingBytes = new List<byte>();

        try
        {
            while (!cancellationToken.IsCancellationRequested &&
                   TcpClient.IsConnected)
            {
                int byteCount = await TcpClient.ReceiveAsync(
                    receiveBuffer,
                    cancellationToken);

                if (byteCount == 0)
                {
                    await InvokeAsync(() =>
                    {
                        _isError = true;
                        _message = "Slave TCP bağlantısını kapattı.";
                        StateHasChanged();
                    });

                    await TcpClient.DisconnectAsync();
                    break;
                }

                pendingBytes.AddRange(
                    receiveBuffer.AsSpan(0, byteCount).ToArray());

                await ProcessPendingResponseBytesAsync(pendingBytes);
            }
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
            // Kullanıcı bağlantıyı kapattığında normal olarak oluşur.
        }
        catch (Exception)
            when (cancellationToken.IsCancellationRequested)
        {
            // Bağlantı kapatılırken NetworkStream de kapanmış olabilir.
        }
        catch (Exception exception)
        {
            await InvokeAsync(() =>
            {
                _isError = true;
                _message = $"Slave cevabı alınamadı: {exception.Message}";
                StateHasChanged();
            });
        }
    }

    private async Task ProcessPendingResponseBytesAsync(
        List<byte> pendingBytes)
    {
        const int MbapHeaderByteCount = 7;

        while (pendingBytes.Count >= MbapHeaderByteCount)
        {
            ushort protocolId = ReadUInt16BigEndian(pendingBytes, 2);
            ushort length = ReadUInt16BigEndian(pendingBytes, 4);

            if (protocolId != 0)
            {
                pendingBytes.Clear();
                await ShowResponseErrorAsync(
                    $"Geçersiz Modbus Protocol ID alındı: {protocolId}.");
                return;
            }

            if (length is < 2 or > 254)
            {
                pendingBytes.Clear();
                await ShowResponseErrorAsync(
                    $"Geçersiz Modbus MBAP Length alındı: {length}.");
                return;
            }

            int totalFrameByteCount = 6 + length;

            if (pendingBytes.Count < totalFrameByteCount)
            {
                return;
            }

            byte[] responseBytes = pendingBytes
                .GetRange(0, totalFrameByteCount)
                .ToArray();

            pendingBytes.RemoveRange(0, totalFrameByteCount);

            await ProcessModbusResponseAsync(responseBytes);
        }
    }

    private async Task ProcessModbusResponseAsync(byte[] response)
    {
        ushort transactionId = ReadUInt16BigEndian(response, 0);
        byte unitId = response[6];
        byte functionCode = response[7];

        PendingReadRequest? pendingRequest = TakePendingRequest(transactionId);

        if ((functionCode & 0x80) != 0)
        {
            byte exceptionCode = response.Length > 8
                ? response[8]
                : (byte)0;

            await ShowResponseErrorAsync(
                $"Slave Modbus hata cevabı gönderdi. " +
                $"Transaction ID: {transactionId}, " +
                $"Exception Code: 0x{exceptionCode:X2} " +
                $"({GetExceptionName(exceptionCode)}).");
            return;
        }

        if (functionCode != ReadHoldingRegistersFunctionCode)
        {
            await ShowResponseErrorAsync(
                $"Beklenmeyen Function Code alındı: 0x{functionCode:X2}.");
            return;
        }

        if (pendingRequest is not null &&
            functionCode != pendingRequest.FunctionCode)
        {
            await ShowResponseErrorAsync(
                $"Transaction ID {transactionId} için " +
                $"0x{pendingRequest.FunctionCode:X2} cevabı beklenirken " +
                $"0x{functionCode:X2} alındı.");
            return;
        }

        if (response.Length < 9)
        {
            await ShowResponseErrorAsync(
                $"Eksik Function {functionCode:X2} cevabı alındı.");
            return;
        }

        int registerByteCount = response[8];

        if (registerByteCount == 0 ||
            registerByteCount % 2 != 0 ||
            response.Length != 9 + registerByteCount)
        {
            await ShowResponseErrorAsync(
                $"Function {functionCode:X2} cevabındaki byte sayısı geçersiz.");
            return;
        }

        var registerValues = new ushort[registerByteCount / 2];

        for (int index = 0; index < registerValues.Length; index++)
        {
            registerValues[index] = ReadUInt16BigEndian(
                response,
                9 + (index * 2));
        }

        if (pendingRequest is not null &&
            registerValues.Length != pendingRequest.Quantity)
        {
            await ShowResponseErrorAsync(
                $"Slave {pendingRequest.Quantity} register yerine " +
                $"{registerValues.Length} register döndürdü.");
            return;
        }

        var record = new ModbusMasterResponseRecord
        {
            TransactionId = transactionId,
            UnitId = unitId,
            FunctionCode = functionCode,
            StartAddress = pendingRequest?.StartAddress,
            RegisterValues = registerValues,
            ReceivedAt = DateTime.Now,
            Hex = BitConverter.ToString(response).Replace("-", " ")
        };

        await InvokeAsync(() =>
        {
            ResponseStore.Add(record);

            _isError = false;
            _message =
                $"Transaction ID {transactionId} cevabı alındı: " +
                $"{registerValues.Length} " +
                $"{GetFunctionName(functionCode)} tamamlandı.";

            StateHasChanged();
        });
    }

    private PendingReadRequest? TakePendingRequest(ushort transactionId)
    {
        lock (_pendingRequestsLock)
        {
            if (!_pendingReadRequests.Remove(
                    transactionId,
                    out PendingReadRequest? request))
            {
                return null;
            }

            return request;
        }
    }

    private void ClearPendingRequests()
    {
        lock (_pendingRequestsLock)
        {
            _pendingReadRequests.Clear();
        }
    }

    private Task ShowResponseErrorAsync(string message)
    {
        return InvokeAsync(() =>
        {
            _isError = true;
            _message = message;
            StateHasChanged();
        });
    }

    private void ClearModbusResponses()
    {
        ResponseStore.Clear();
    }

    private void OnResponseStoreChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static int GetRegisterAddress(
        ModbusMasterResponseRecord response,
        int index)
    {
        return response.StartAddress.HasValue
            ? response.StartAddress.Value + index
            : index;
    }

    private static string GetExceptionName(byte exceptionCode)
    {
        return exceptionCode switch
        {
            0x01 => "Illegal Function",
            0x02 => "Illegal Data Address",
            0x03 => "Illegal Data Value",
            0x04 => "Server Device Failure",
            _ => "Bilinmeyen hata"
        };
    }

    private static string GetFunctionName(byte functionCode)
    {
        return functionCode switch
        {
            ReadCoilsFunctionCode => "Read Coils",
            ReadHoldingRegistersFunctionCode => "Holding Register",
            WriteSingleRegisterFunctionCode => "Write Single Register",
            _ => "Bilinmeyen fonksiyon"
        };
    }

    private static ushort ReadUInt16BigEndian(
        IReadOnlyList<byte> bytes,
        int index)
    {
        return (ushort)(
            (bytes[index] << 8) |
            bytes[index + 1]);
    }

    private sealed record PendingReadRequest(
        byte FunctionCode,
        ushort StartAddress,
        ushort Quantity);

    public void Dispose()
    {
        StopReceiveLoop();
        TcpClient.ConnectionStateChanged -= OnConnectionStateChanged;
        ResponseStore.DataChanged -= OnResponseStoreChanged;
    }
}
